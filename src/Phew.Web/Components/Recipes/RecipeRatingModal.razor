@implements IDisposable
@using Phew.Core.Models
@using Phew.Core.Services
@using Phew.Infrastructure.Services
@using Phew.Web.Components.Common
@inject IServiceProvider ServiceProvider
@inject ILogger<RecipeRatingModal> Logger

<FluentDialog Class="rating-modal-dialog"
              Modal="true"
              TrapFocus="true"
              PreventScroll="true"
              Hidden="@(!IsVisible)"
              HiddenChanged="HandleHiddenChanged"
              AriaLabelledby="@titleId">
    @if (IsVisible)
    {
        <div class="rating-modal" @onkeydown="HandleKeyDown">
            <div class="rating-modal-header">
                <div class="rating-modal-title-group">
                    <h2 id="@titleId" class="rating-modal-title">Familjens betyg</h2>
                    @if (!string.IsNullOrWhiteSpace(RecipeTitle))
                    {
                        <p class="rating-modal-subtitle">@RecipeTitle</p>
                    }
                </div>
                <button type="button"
                        class="rating-modal-close"
                        aria-label="Stäng betygsättning"
                        title="Stäng"
                        @onclick="CloseAsync">
                    <FluentIcon Value="@(new Icons.Regular.Size24.Dismiss())" Color="Color.Neutral" />
                </button>
            </div>

            <div class="rating-modal-summary" aria-live="polite">
                @if (summary.HasRatings)
                {
                    <span class="rating-modal-summary-star is-filled" aria-hidden="true">★</span>
                    <span class="rating-modal-summary-score">@summary.FormatAverageSwedish()</span>
                    <span class="rating-modal-summary-votes">(@summary.FormatVoteCountSwedish())</span>
                }
                else
                {
                    <span class="rating-modal-summary-star is-empty" aria-hidden="true">☆</span>
                    <span class="rating-modal-summary-empty">Inga betyg ännu</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="rating-modal-error" role="alert">
                    <span aria-hidden="true">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            @if (isLoading)
            {
                <div class="rating-modal-loading">
                    <FluentProgressRing />
                </div>
            }
            else if (memberRows.Count == 0)
            {
                <div class="rating-modal-empty">
                    <p>Inga aktiva familjemedlemmar är registrerade ännu. Lägg till familjemedlemmar i inställningarna för att kunna betygsätta recept.</p>
                    <a href="/installningar" class="btn-primary-custom" @onclick="CloseAsync">
                        Gå till inställningar
                    </a>
                </div>
            }
            else
            {
                <div class="rating-member-list" role="list" aria-label="Familjemedlemmarnas betyg">
                    @foreach (var row in memberRows)
                    {
                        var currentStars = row.Stars ?? 0;
                        <div class="rating-member-row" role="listitem">
                            <span class="rating-member-name" title="@row.FamilyMemberName">@row.FamilyMemberName</span>
                            <div class="rating-stars-group"
                                 role="group"
                                 aria-label="@($"Betyg för {row.FamilyMemberName}")">
                                @for (int star = RecipeRating.MinStars; star <= RecipeRating.MaxStars; star++)
                                {
                                    var starValue = star;
                                    var isFilled = starValue <= currentStars;
                                    var isSelected = row.Stars == starValue;
                                    <button type="button"
                                            class="rating-star-btn @(isFilled ? "is-filled" : "is-empty")"
                                            aria-label="@GetStarAriaLabel(row, starValue)"
                                            aria-pressed="@(isSelected ? "true" : "false")"
                                            disabled="@isSaving"
                                            @onclick="() => SelectStarAsync(row, starValue)">
                                        <span aria-hidden="true">@(isFilled ? "★" : "☆")</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</FluentDialog>

<ContextualFeedback State="successFeedback" Floating="true" CssClass="rating-modal-feedback" />

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public int RecipeId { get; set; }
    [Parameter] public string RecipeTitle { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<RecipeRatingSummary> OnRatingChanged { get; set; }

    private readonly string titleId = $"rating-modal-title-{Guid.NewGuid():N}";
    private readonly FeedbackState successFeedback = new();

    private RecipeRatingService? _ratingService;
    private FamilyMemberNotifier? _familyMemberNotifier;

    private List<FamilyMemberRatingRowDto> memberRows = new();
    private RecipeRatingSummary summary = RecipeRatingSummary.Empty;
    private bool isLoading;
    private bool isSaving;
    private string? errorMessage;
    private bool _wasVisible;
    private int _loadedRecipeId;
    private bool _isDisposed;

    protected override void OnInitialized()
    {
        _ratingService = ServiceProvider.GetService<RecipeRatingService>();
        _familyMemberNotifier = ServiceProvider.GetService<FamilyMemberNotifier>();

        if (_ratingService != null)
        {
            _ratingService.OnChanged += HandleExternalChange;
        }

        if (_familyMemberNotifier != null)
        {
            _familyMemberNotifier.OnChanged += HandleExternalChange;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && (!_wasVisible || _loadedRecipeId != RecipeId))
        {
            _wasVisible = true;
            _loadedRecipeId = RecipeId;
            errorMessage = null;
            await LoadModalDataAsync();
        }
        else if (!IsVisible && _wasVisible)
        {
            _wasVisible = false;
            errorMessage = null;
        }
    }

    private async Task LoadModalDataAsync()
    {
        if (_ratingService == null || RecipeId <= 0)
        {
            memberRows = new();
            summary = RecipeRatingSummary.Empty;
            return;
        }

        isLoading = true;
        try
        {
            var data = await _ratingService.GetModalDataAsync(RecipeId);
            summary = data.Summary;
            memberRows = data.MemberRows.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kunde inte ladda betygsdata för recept {RecipeId}", RecipeId);
            errorMessage = "Kunde inte ladda betyg. Försök igen.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectStarAsync(FamilyMemberRatingRowDto row, int stars)
    {
        if (_ratingService == null || isSaving)
        {
            return;
        }

        errorMessage = null;
        isSaving = true;
        try
        {
            var updatedSummary = await _ratingService.SetRatingAsync(RecipeId, row.FamilyMemberId, stars);
            summary = updatedSummary;

            var index = memberRows.FindIndex(r => r.FamilyMemberId == row.FamilyMemberId);
            if (index >= 0)
            {
                memberRows[index] = row with { Stars = stars };
            }

            successFeedback.ShowSuccess($"Betyg sparat för {row.FamilyMemberName}: {stars} av 5 stjärnor.");

            if (OnRatingChanged.HasDelegate)
            {
                await OnRatingChanged.InvokeAsync(updatedSummary);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kunde inte spara betyg för recept {RecipeId} och medlem {FamilyMemberId}", RecipeId, row.FamilyMemberId);
            errorMessage = "Kunde inte spara betyget. Försök igen.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetStarAriaLabel(FamilyMemberRatingRowDto row, int star)
    {
        var baseLabel = $"Ge {row.FamilyMemberName} {star} av 5 stjärnor för {RecipeTitle}";
        return row.Stars == star
            ? $"{baseLabel} (valt betyg: {star})"
            : baseLabel;
    }

    private void HandleExternalChange(long _version)
    {
        if (_isDisposed || !IsVisible)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_isDisposed || !IsVisible)
            {
                return;
            }

            await LoadModalDataAsync();
            StateHasChanged();
        });
    }

    private async Task CloseAsync()
    {
        if (!IsVisible)
        {
            return;
        }

        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private Task HandleHiddenChanged(bool hidden) => hidden ? CloseAsync() : Task.CompletedTask;

    private Task HandleKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    public void Dispose()
    {
        _isDisposed = true;
        if (_ratingService != null)
        {
            _ratingService.OnChanged -= HandleExternalChange;
        }

        if (_familyMemberNotifier != null)
        {
            _familyMemberNotifier.OnChanged -= HandleExternalChange;
        }
    }
}
