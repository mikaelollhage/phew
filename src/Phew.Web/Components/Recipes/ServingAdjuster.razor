<div class="servings-adjuster">
    <button type="button"
            class="servings-btn"
            @onclick="Decrement"
            disabled="@(CurrentServings <= 1)"
            aria-label="Minska portioner"
            title="Minska portioner">
        −
    </button>
    <span class="servings-count" aria-label="@($"{CurrentServings} {Unit}")">@CurrentServings&#32;<span class="servings-unit">@Unit</span></span>
    <button type="button"
            class="servings-btn"
            @onclick="Increment"
            disabled="@(CurrentServings >= 50)"
            aria-label="Öka portioner"
            title="Öka portioner">
        +
    </button>
</div>

@code {
    [Parameter] public int CurrentServings { get; set; } = 4;
    [Parameter] public string Unit { get; set; } = "portioner";
    [Parameter] public EventCallback<int> OnServingsChanged { get; set; }

    private async Task Decrement()
    {
        if (CurrentServings > 1)
        {
            CurrentServings--;
            await OnServingsChanged.InvokeAsync(CurrentServings);
        }
    }

    private async Task Increment()
    {
        if (CurrentServings < 50)
        {
            CurrentServings++;
            await OnServingsChanged.InvokeAsync(CurrentServings);
        }
    }
}

