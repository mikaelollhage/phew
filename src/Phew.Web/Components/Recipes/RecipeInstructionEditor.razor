@namespace Phew.Web.Components.Recipes
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="form-section">
    <div class="instruction-editor-header">
        @if (HeadingLevel == 3)
        {
            <h3 class="form-section-title" style="margin-bottom: 0;">@HeadingText</h3>
        }
        else
        {
            <h2 class="form-section-title" style="margin-bottom: 0;">@HeadingText</h2>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <p class="ingredient-editor-help">
            @HelpText
        </p>
    }

    <div class="instruction-editor-list">
        @if (openMenuStep != null)
        {
            <div class="ingredient-row-menu-backdrop instruction-row-menu-backdrop"
                 @onclick="CloseRowMenu"
                 @onclick:stopPropagation="true"></div>
        }

        @for (int i = 0; i < Instructions.Count; i++)
        {
            var step = Instructions[i];
            var index = i;
            var stepNumber = index + 1;
            var stepKey = GetStepKey(step);
            var textAreaId = GetTextAreaId(stepKey);

            <RecipeInstructionRow @key="step"
                                  Step="step"
                                  StepNumber="@stepNumber"
                                  TextAreaId="@textAreaId"
                                  OnRemove="@(() => RemoveInstruction(index))">
                <RowActions>
                    @RenderRowMenu(step, stepKey, index, stepNumber)
                </RowActions>
            </RecipeInstructionRow>
        }
    </div>

    <div class="instruction-add-row">
        <input id="@_addInputId"
               type="text"
               class="form-input-custom instruction-add-input"
               placeholder="Lägg till steg..."
               aria-label="Nytt tillagningssteg"
               @bind="newStepText"
               @bind:event="oninput"
               @onkeydown="HandleAddInputKeyDown" />
        <button type="button"
                class="btn-primary-custom instruction-add-btn"
                title="Lägg till steg"
                aria-label="Lägg till steg"
                disabled="@string.IsNullOrWhiteSpace(newStepText)"
                @onclick="AddInstructionFromInput">
            <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Color="Color.Custom" CustomColor="currentColor" />
        </button>
    </div>
</div>

@code {
    [Parameter]
    public IList<InstructionStep> Instructions { get; set; } = new List<InstructionStep>();

    [Parameter]
    public string Title { get; set; } = "Instruktioner";

    [Parameter]
    public Func<int, string>? TitleFormatter { get; set; }

    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    [Parameter]
    public string? HelpText { get; set; }

    [Parameter]
    public string AddButtonText { get; set; } = "Lägg till steg";

    [Parameter]
    public bool ShowAddIcon { get; set; } = true;

    [Parameter]
    public EventCallback<InstructionStep> OnInstructionAdded { get; set; }

    [Parameter]
    public EventCallback<int> OnInstructionRemoved { get; set; }

    private readonly string _editorInstanceId = Guid.NewGuid().ToString("N")[..8];
    private readonly string _addInputId;
    private readonly Dictionary<InstructionStep, int> _stepKeys = new(ReferenceEqualityComparer.Instance);
    private int _nextStepKey = 1;

    private IList<InstructionStep>? _lastInstructionsRef;
    private InstructionStep? openMenuStep;
    private string newStepText = string.Empty;
    private string? _pendingFocusElementId;
    private DotNetObjectReference<RecipeInstructionEditor>? _dotNetRef;
    private bool _isDisposed;

    public RecipeInstructionEditor()
    {
        _addInputId = $"instruction-add-input-{_editorInstanceId}";
    }

    private string HeadingText => TitleFormatter != null ? TitleFormatter(Instructions.Count) : Title;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Instructions, _lastInstructionsRef))
        {
            _lastInstructionsRef = Instructions;
            openMenuStep = null;
            _pendingFocusElementId = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("phew.registerRowMenuHost", _dotNetRef);
            }
            catch
            {
                // Ignore when JS runtime is unavailable (e.g. unit tests)
            }
        }

        if (!string.IsNullOrEmpty(_pendingFocusElementId))
        {
            var elementId = _pendingFocusElementId;
            _pendingFocusElementId = null;
            try
            {
                await JSRuntime.InvokeVoidAsync("phew.focusElement", elementId);
            }
            catch
            {
                // Ignore when JS runtime is unavailable (e.g. unit tests)
            }
        }
    }

    private int GetStepKey(InstructionStep step)
    {
        if (!_stepKeys.TryGetValue(step, out var key))
        {
            key = _nextStepKey++;
            _stepKeys[step] = key;
        }
        return key;
    }

    private string GetTextAreaId(int stepKey) => $"instruction-step-text-{_editorInstanceId}-{stepKey}";

    private string GetMenuButtonId(int stepKey) => $"instruction-menu-btn-{_editorInstanceId}-{stepKey}";

    private RenderFragment RenderRowMenu(InstructionStep step, int stepKey, int index, int stepNumber) => __builder =>
    {
        var isMenuOpen = ReferenceEquals(openMenuStep, step);

        <div class="ingredient-row-menu-anchor instruction-row-menu-anchor @(isMenuOpen ? "is-open" : "")"
             @onkeydown="@(e => HandleMenuKeyDown(e, stepKey))">
            <button type="button"
                    id="@GetMenuButtonId(stepKey)"
                    class="btn-secondary-custom ingredient-row-menu-btn instruction-row-menu-btn @(isMenuOpen ? "is-active" : "")"
                    title="@($"Åtgärder för steg {stepNumber}")"
                    aria-label="@($"Åtgärder för steg {stepNumber}")"
                    aria-haspopup="menu"
                    aria-expanded="@(isMenuOpen ? "true" : "false")"
                    @onclick="@(() => ToggleRowMenu(step))"
                    @onclick:stopPropagation="true">
                <FluentIcon Value="@(new Icons.Regular.Size16.MoreHorizontal())" Color="Color.Custom" CustomColor="currentColor" />
            </button>

            @if (isMenuOpen)
            {
                <div class="ingredient-row-menu-popover instruction-row-menu-popover"
                     role="menu"
                     aria-label="@($"Åtgärder för steg {stepNumber}")"
                     @onclick:stopPropagation="true">
                    <button type="button"
                            role="menuitem"
                            class="ingredient-row-menu-item instruction-move-up-btn"
                            disabled="@(index <= 0)"
                            @onclick="@(() => MoveStepByOffset(index, -1))">
                        <span class="ingredient-row-menu-icon" aria-hidden="true">↑</span>
                        <span>Flytta upp</span>
                    </button>
                    <button type="button"
                            role="menuitem"
                            class="ingredient-row-menu-item instruction-move-down-btn"
                            disabled="@(index >= Instructions.Count - 1)"
                            @onclick="@(() => MoveStepByOffset(index, 1))">
                        <span class="ingredient-row-menu-icon" aria-hidden="true">↓</span>
                        <span>Flytta ned</span>
                    </button>
                    <FluentDivider Role="DividerRole.Separator" Class="ingredient-row-menu-separator" />
                    <button type="button"
                            role="menuitem"
                            class="ingredient-row-menu-item instruction-insert-above-btn"
                            @onclick="@(() => InsertStepAt(index))">
                        <span class="ingredient-row-menu-icon" aria-hidden="true">↰</span>
                        <span>Infoga steg ovanför</span>
                    </button>
                    <button type="button"
                            role="menuitem"
                            class="ingredient-row-menu-item instruction-insert-below-btn"
                            @onclick="@(() => InsertStepAt(index + 1))">
                        <span class="ingredient-row-menu-icon" aria-hidden="true">↳</span>
                        <span>Infoga steg nedanför</span>
                    </button>
                    <FluentDivider Role="DividerRole.Separator" Class="ingredient-row-menu-separator" />
                    <button type="button"
                            role="menuitem"
                            class="ingredient-row-menu-item instruction-remove-btn is-danger"
                            @onclick="@(() => RemoveInstruction(index))">
                        <span class="ingredient-row-menu-icon" aria-hidden="true">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Custom" CustomColor="currentColor" />
                        </span>
                        <span>Ta bort steg</span>
                    </button>
                </div>
            }
        </div>
    };

    private async Task ToggleRowMenu(InstructionStep step)
    {
        openMenuStep = ReferenceEquals(openMenuStep, step) ? null : step;
        if (openMenuStep != null && _dotNetRef != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("phew.closeOtherRowMenus", _dotNetRef);
            }
            catch
            {
                // Ignore when JS runtime is unavailable (e.g. unit tests)
            }
        }
    }

    private void CloseRowMenu()
    {
        openMenuStep = null;
    }

    [JSInvokable]
    public Task CloseRowMenuAsync()
    {
        if (_isDisposed || openMenuStep == null)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(() =>
        {
            if (_isDisposed)
            {
                return;
            }

            openMenuStep = null;
            StateHasChanged();
        });
    }

    private void HandleMenuKeyDown(KeyboardEventArgs e, int stepKey)
    {
        if (e.Key == "Escape" && openMenuStep != null)
        {
            openMenuStep = null;
            _pendingFocusElementId = GetMenuButtonId(stepKey);
        }
    }

    private void MoveStepByOffset(int index, int offset)
    {
        var targetIndex = index + offset;
        if (index < 0 || index >= Instructions.Count || targetIndex < 0 || targetIndex >= Instructions.Count)
        {
            return;
        }

        var step = Instructions[index];
        Instructions.RemoveAt(index);
        Instructions.Insert(targetIndex, step);
        RenumberSteps();
    }

    private async Task InsertStepAt(int insertIndex)
    {
        openMenuStep = null;
        var clampedIndex = Math.Clamp(insertIndex, 0, Instructions.Count);
        var newStep = new InstructionStep
        {
            InstructionText = string.Empty
        };

        Instructions.Insert(clampedIndex, newStep);
        RenumberSteps();

        var stepKey = GetStepKey(newStep);
        _pendingFocusElementId = GetTextAreaId(stepKey);

        if (OnInstructionAdded.HasDelegate)
        {
            await OnInstructionAdded.InvokeAsync(newStep);
        }
    }

    private async Task HandleAddInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newStepText))
        {
            await AddInstructionFromInput();
        }
    }

    private async Task AddInstructionFromInput()
    {
        var trimmed = newStepText?.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return;
        }

        openMenuStep = null;
        var newStep = new InstructionStep
        {
            InstructionText = trimmed
        };

        Instructions.Add(newStep);
        RenumberSteps();
        newStepText = string.Empty;

        if (OnInstructionAdded.HasDelegate)
        {
            await OnInstructionAdded.InvokeAsync(newStep);
        }
    }

    private async Task RemoveInstruction(int index)
    {
        if (index < 0 || index >= Instructions.Count)
        {
            return;
        }

        openMenuStep = null;
        Instructions.RemoveAt(index);
        RenumberSteps();

        if (Instructions.Count > 0)
        {
            var nextFocusIndex = Math.Min(index, Instructions.Count - 1);
            var nextKey = GetStepKey(Instructions[nextFocusIndex]);
            _pendingFocusElementId = GetTextAreaId(nextKey);
        }
        else
        {
            _pendingFocusElementId = _addInputId;
        }

        if (OnInstructionRemoved.HasDelegate)
        {
            await OnInstructionRemoved.InvokeAsync(index);
        }
    }

    private void RenumberSteps()
    {
        for (int i = 0; i < Instructions.Count; i++)
        {
            Instructions[i].StepNumber = i + 1;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        if (_dotNetRef != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("phew.unregisterRowMenuHost", _dotNetRef);
            }
            catch
            {
                // Ignore during prerender/teardown
            }

            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }
}
