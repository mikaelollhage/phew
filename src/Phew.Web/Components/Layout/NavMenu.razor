<div class="brand-section">
    <a href="" class="brand-link" aria-label="PHEW! – Family life, sorted." @onclick="NotifyNavigateAsync">
        <img src="/phew-logo.webp"
             alt=""
             width="148"
             height="148"
             class="brand-logo-full"
             aria-hidden="true"
             decoding="async" />
    </a>
</div>

<nav class="sidebar-nav" aria-label="Sidomeny">
    <NavLink class="nav-link-custom" href="" Match="NavLinkMatch.All" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.Home())" Color="Color.Neutral" />
        <span>Hem</span>
    </NavLink>

    <NavLink class="nav-link-custom" href="kalender" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.CalendarDate())" Color="Color.Neutral" />
        <span>Kalender</span>
    </NavLink>

    <div class="sidebar-divider"></div>

    <NavLink class="nav-link-custom" href="veckomeny" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.CalendarLtr())" Color="Color.Neutral" />
        <span>Veckomeny</span>
    </NavLink>

    <NavLink class="nav-link-custom" href="recept" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.BookOpen())" Color="Color.Neutral" />
        <span>Recept</span>
    </NavLink>

    <NavLink class="nav-link-custom" href="favoriter" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.Star())" Color="Color.Neutral" />
        <span>Favoriter</span>
    </NavLink>

    <NavLink class="nav-link-custom" href="kategorier" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.Tag())" Color="Color.Neutral" />
        <span>Kategorier</span>
    </NavLink>

    <NavLink class="nav-link-custom" href="importera" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowDownload())" Color="Color.Neutral" />
        <span>Importera recept</span>
    </NavLink>

    <div class="sidebar-divider"></div>

    <NavLink class="nav-link-custom" href="inkopslista" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.Cart())" Color="Color.Neutral" />
        <span>Inköpslista</span>
    </NavLink>

    <NavLink class="nav-link-custom" href="att-gora" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.CheckboxChecked())" Color="Color.Neutral" />
        <span>Att göra</span>
    </NavLink>

    <div class="sidebar-divider"></div>

    <NavLink class="nav-link-custom" href="installningar" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" Color="Color.Neutral" />
        <span>Inställningar</span>
    </NavLink>

    <NavLink class="nav-link-custom" href="backup" @onclick="NotifyNavigateAsync">
        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSync())" Color="Color.Neutral" />
        <span>Säkerhetskopia</span>
    </NavLink>
</nav>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private Task NotifyNavigateAsync()
    {
        return OnNavigate.HasDelegate ? OnNavigate.InvokeAsync() : Task.CompletedTask;
    }
}
