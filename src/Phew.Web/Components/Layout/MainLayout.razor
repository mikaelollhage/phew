@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject AppNotificationService NotificationService
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JSRuntime

<FluentDesignTheme Mode="@CurrentFluentThemeMode" />
<FluentDialogProvider />

<div class="app-container">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <div class="app-main">
        @if (NotificationService.HasNotification)
        {
            var bannerClass = NotificationService.IsSuccess ? "app-top-banner-success" : (NotificationService.IsError ? "app-top-banner-error" : "app-top-banner-warning");
            var icon = NotificationService.IsSuccess ? "✓" : (NotificationService.IsError ? "✕" : "⚠");
            var bannerRole = NotificationService.IsError ? "alert" : "status";
            <div class="app-top-banner @bannerClass" role="@bannerRole">
                <div class="app-top-banner-content">
                    <span class="app-top-banner-icon" aria-hidden="true">@icon</span>
                    <div class="app-top-banner-text">
                        <div class="app-top-banner-title">@NotificationService.Title</div>
                        <div class="app-top-banner-desc">@NotificationService.Message</div>
                    </div>
                </div>
                <button type="button" class="app-top-banner-close" @onclick="NotificationService.Clear" aria-label="Stäng meddelande" title="Stäng meddelande">
                    ✕ Stäng
                </button>
            </div>
        }

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<div id="components-reconnect-modal" class="rb-reconnect-modal" role="status" aria-live="polite" data-nosnippet>
    <div class="rb-reconnect-msg rb-reconnect-retrying">
        <span>⚠ Anslutningen till servern bröts – återansluter...</span>
    </div>
    <div class="rb-reconnect-msg rb-reconnect-failed">
        <span>✕ Kunde inte återansluta automatiskt.</span>
        <button type="button" class="btn-secondary-custom rb-reconnect-btn" onclick="location.reload()">Ladda om sidan</button>
    </div>
    <div class="rb-reconnect-msg rb-reconnect-rejected">
        <span>✕ Sessionen har upphört (servern kan ha startats om).</span>
        <button type="button" class="btn-secondary-custom rb-reconnect-btn" onclick="location.reload()">Ladda om sidan</button>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ett fel har inträffat.
    <a href="." class="reload">Ladda om</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private AppThemeService? _themeService;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private bool _isDisposed;

    private DesignThemeModes CurrentFluentThemeMode =>
        _themeService?.FluentMode ?? DesignThemeModes.Dark;

    protected override void OnInitialized()
    {
        _themeService = ServiceProvider.GetService<AppThemeService>();
        if (_themeService != null)
        {
            _themeService.OnChange += OnThemeChanged;
        }

        NotificationService.OnChange += OnNotificationChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isDisposed && _themeService != null)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await _themeService.InitializeAsync(JSRuntime, _dotNetRef);
        }
    }

    [JSInvokable]
    public Task OnClientThemeChangedAsync(string? preference, string? resolved)
    {
        if (_isDisposed || _themeService == null)
        {
            return Task.CompletedTask;
        }

        _themeService.UpdateFromClient(preference, resolved);
        return Task.CompletedTask;
    }

    private void OnThemeChanged()
    {
        if (!_isDisposed)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnNotificationChanged()
    {
        if (!_isDisposed)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (NotificationService.HasNotification)
        {
            NotificationService.Clear();
        }
        if (!_isDisposed)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed)
        {
            return;
        }

        _isDisposed = true;
        if (_themeService != null)
        {
            _themeService.OnChange -= OnThemeChanged;
        }
        NotificationService.OnChange -= OnNotificationChanged;
        Navigation.LocationChanged -= OnLocationChanged;

        if (_dotNetRef != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("phew.unregisterThemeListener", _dotNetRef);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
            {
                // Ignore disconnected circuits or test hosts
            }
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }
}
