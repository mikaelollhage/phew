@page "/backup"
@inject IBackupService BackupService
@inject IJSRuntime JSRuntime
@inject ILogger<BackupPlaceholder> Logger

<PageTitle>Säkerhetskopiering — PHEW!</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">💾 Säkerhetskopiering & Återställning</h1>
        <p class="page-subtitle">Exportera och återställ recept, inköpslista, att göra-listor, veckomenyer, familjekalender och matbilder i en portabel ZIP-fil.</p>
    </div>
</div>

<div class="recipe-detail-grid">
    <div class="detail-card">
        <div class="detail-card-title">
            <span>📦 Exportera säkerhetskopia</span>
        </div>

        <p style="font-size: 14px; color: var(--rb-text-secondary); margin-bottom: 10px; line-height: 1.6;">
            Skapar ett komplett ZIP-arkiv med <code>manifest.json</code>, <code>data.json</code> och lokala bilder i <code>images/recipes/</code>. Säkerhetskopian innehåller:
        </p>
        <ul style="font-size: 14px; color: var(--rb-text-secondary); margin-bottom: 20px; padding-left: 20px; line-height: 1.6;">
            <li>Recept, ingredienser, kategorier och bilder.</li>
            <li>Inköpslistan.</li>
            <li>Att göra-listor, inklusive uppgifter och arkiverade listor.</li>
            <li>Veckomenyer.</li>
            <li>Familjekalendern, inklusive återkommande händelser.</li>
            <li>Familjemedlemmar (aktiva och inaktiva).</li>
        </ul>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <button type="button"
                    class="btn-primary-custom"
                    disabled="@isExporting"
                    @onclick="ExportBackupAsync">
                @if (isExporting)
                {
                    <span>Skapar arkiv...</span>
                }
                else
                {
                    <span>⬇️ Ladda ner säkerhetskopia (.zip)</span>
                }
            </button>
        </div>

        <ContextualFeedback State="exportFeedback" Floating="@exportFeedback.IsSuccess" CssClass="backup-export-feedback" />
    </div>

    <div class="detail-card">
        <div class="detail-card-title">
            <span>♻️ Återställ från säkerhetskopia</span>
        </div>

        <p style="font-size: 14px; color: var(--rb-text-secondary); margin-bottom: 16px; line-height: 1.6;">
            Välj en tidigare exporterad <code>.zip</code>-fil från PHEW!. Återställningen ersätter all befintlig data — recept, ingredienser, kategorier, bilder, inköpslistan, att göra-listor, veckomenyer, familjemedlemmar samt familjekalendern inklusive återkommande händelser — med innehållet i backupfilen. Återställningen utförs transaktionellt med automatisk rollback och skuggkopiering av bildmappen om något fel skulle inträffa.
        </p>

        <div class="form-group">
            <label class="form-label">Välj säkerhetskopia (.zip, max 100 MB)</label>
            <InputFile OnChange="HandleBackupFileSelected" accept=".zip,application/zip" class="form-input-custom" />
        </div>

        <ContextualFeedback State="restoreFeedback" CssClass="backup-restore-feedback" />

        @if (selectedFile != null)
        {
            <div style="margin-top: 16px;">
                <button type="button"
                        class="btn-primary-custom"
                        disabled="@isRestoring"
                        @onclick="@(() => showRestoreConfirm = true)">
                    @if (isRestoring)
                    {
                        <span>Återställer säkerhetskopia...</span>
                    }
                    else
                    {
                        <span>🚀 Starta återställning (@selectedFile.Name)</span>
                    }
                </button>
            </div>
        }
    </div>
</div>

<ConfirmDialog IsVisible="showRestoreConfirm"
               Title="Bekräfta återställning av säkerhetskopia"
               Message="Är du säker? Alla nuvarande data — recept, ingredienser, kategorier, bilder, inköpslistan, att göra-listor, veckomenyer, familjemedlemmar samt familjekalendern inklusive återkommande händelser — kommer att ersättas helt med innehållet i backupfilen."
               ConfirmText="Ja, återställ nu"
               CancelText="Avbryt"
               OnConfirm="ExecuteRestoreAsync"
               OnCancel="@(() => showRestoreConfirm = false)" />

@code {
    private const long MaxUploadSize = 100L * 1024 * 1024; // 100 MB
    private IBrowserFile? selectedFile;
    private bool isExporting = false;
    private bool isRestoring = false;
    private bool showRestoreConfirm = false;

    private readonly FeedbackState exportFeedback = new();
    private readonly FeedbackState restoreFeedback = new();

    private async Task ExportBackupAsync()
    {
        isExporting = true;
        exportFeedback.Clear();

        try
        {
            var zipBytes = await BackupService.CreateBackupArchiveAsync();
            var fileName = $"phew-backup-{DateTime.Now:yyyyMMdd-HHmm}.zip";
            var base64 = Convert.ToBase64String(zipBytes);
            await JSRuntime.InvokeVoidAsync("phew.downloadFileFromBytes", fileName, "application/zip", base64);
            exportFeedback.ShowSuccess("Säkerhetskopian har skapats och laddats ner.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid export av säkerhetskopia.");
            exportFeedback.ShowError($"Exporten misslyckades: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private void HandleBackupFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        restoreFeedback.Clear();
    }

    private async Task ExecuteRestoreAsync()
    {
        showRestoreConfirm = false;
        if (selectedFile == null)
            return;

        isRestoring = true;
        restoreFeedback.Clear();

        try
        {
            await using var stream = selectedFile.OpenReadStream(MaxUploadSize);
            var result = await BackupService.RestoreFromArchiveAsync(stream, replaceExisting: true);

            if (result.Success)
            {
                restoreFeedback.ShowSuccess($"Återställningen lyckades! {result.RestoredRecipes} recept, {result.RestoredCategories} kategorier, {result.RestoredImages} bilder, {result.RestoredWeeklyMenus} veckomenyer, {result.RestoredCalendarEvents} kalenderhändelser, {result.RestoredTodoLists} att göra-listor ({result.RestoredTodoItems} uppgifter) och {result.RestoredFamilyMembers} familjemedlemmar återställdes.");
                selectedFile = null;
            }
            else
            {
                restoreFeedback.ShowError(result.ErrorMessage ?? "Återställningen misslyckades.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid återställning av säkerhetskopia.");
            restoreFeedback.ShowError($"Ett fel uppstod vid läsning av filen: {ex.Message}");
        }
        finally
        {
            isRestoring = false;
        }
    }
}
