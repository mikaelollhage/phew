@page "/"
@implements IDisposable
@using System.Globalization
@using Phew.Infrastructure.Services
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Hem — PHEW!</PageTitle>

<div class="home-page-intro">
    <h1 class="visually-hidden">Hem</h1>
    <p class="page-subtitle home-date-intro">@GetFormattedDateSubtitle()</p>
</div>

@if (isLoading)
{
    <div style="display: flex; justify-content: center; padding: 60px;">
        <FluentProgressRing />
    </div>
}
else if (mealPlan != null)
{
    <div class="home-dashboard">
    @if (mealPlan.TodayMeal.HasRecipe)
    {
        <TodaysDinnerCard Meal="mealPlan.TodayMeal"
                          ShowDiscreetLink="false"
                          SummaryOverride="todayRatingSummary"
                          OnRateRecipe="OpenRatingModal" />
    }
    else if (mealPlan.TodayMeal.HasSavedMenu)
    {
        <section class="home-card home-empty-card" aria-label="Dagens middag" role="status">
            <div class="home-card-header">
                <div class="home-card-heading-group">
                    <span class="home-card-icon" aria-hidden="true">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Food())" Color="Color.Custom" CustomColor="currentColor" />
                    </span>
                    <h2 class="home-card-title">Dagens middag</h2>
                </div>
            </div>
            <div class="home-empty-state">
                <h3 class="home-empty-title">Ingen middag planerad för idag</h3>
                <p class="home-empty-desc">
                    Välj en rätt i veckomenyn eller hitta inspiration bland dina recept.
                </p>
                <div class="home-empty-actions">
                    <a href="/veckomeny" class="btn-primary-custom" id="home-empty-choose-menu-btn">
                        Välj rätt i veckomenyn
                    </a>
                    <a href="/recept" class="btn-secondary-custom" id="home-empty-browse-recipes-btn">
                        Bläddra bland recept
                    </a>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="home-card home-empty-card" aria-label="Dagens middag" role="status">
            <div class="home-card-header">
                <div class="home-card-heading-group">
                    <span class="home-card-icon" aria-hidden="true">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Food())" Color="Color.Custom" CustomColor="currentColor" />
                    </span>
                    <h2 class="home-card-title">Dagens middag</h2>
                </div>
            </div>
            <div class="home-empty-state">
                <h3 class="home-empty-title">Dags att planera veckan?</h3>
                <p class="home-empty-desc">
                    Det finns ingen veckomeny sparad för den här veckan.
                </p>
                <div class="home-empty-actions">
                    <a href="/veckomeny" class="btn-primary-custom" id="home-empty-plan-week-btn">
                        Öppna veckomenyn
                    </a>
                    <a href="/recept" class="btn-secondary-custom" id="home-empty-browse-recipes-btn">
                        Bläddra bland recept
                    </a>
                </div>
            </div>
        </section>
    }

    @if (mealPlan.TomorrowMeal.HasRecipe)
    {
        var tomorrowRecipe = mealPlan.TomorrowMeal.Recipe!;
        var tomorrowServings = mealPlan.TomorrowMeal.Servings > 0 ? mealPlan.TomorrowMeal.Servings : tomorrowRecipe.Servings;
        var tomorrowDayName = CalendarWeek.GetSwedishDayName(mealPlan.TomorrowMeal.Date);
        var tomorrowDateFormatted = mealPlan.TomorrowMeal.Date.ToString("d MMMM", SwedishCulture);

        <section class="home-card home-tomorrow-card" aria-label="Morgondagens middag">
            <div class="home-card-header home-tomorrow-header">
                <div class="home-card-heading-group">
                    <span class="home-card-icon" aria-hidden="true">
                        <FluentIcon Value="@(new Icons.Regular.Size20.CalendarDate())" Color="Color.Custom" CustomColor="currentColor" />
                    </span>
                    <h2 class="home-card-title">Morgondagens middag</h2>
                    @if (mealPlan.TomorrowMeal.IsDraft)
                    {
                        <span class="weekly-status-badge status-draft">Utkast</span>
                    }
                </div>
                <span class="home-tomorrow-date">@tomorrowDayName @tomorrowDateFormatted</span>
            </div>
            <div class="home-tomorrow-body">
                <div class="home-tomorrow-info">
                    <a href="@($"/recept/{tomorrowRecipe.Id}")" class="home-tomorrow-title-link">
                        @tomorrowRecipe.Title
                    </a>
                    <div class="home-tomorrow-meta">
                        @if (tomorrowRecipe.TotalTimeMinutes.HasValue)
                        {
                            <span class="home-meta-item">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Clock())" Color="Color.Custom" CustomColor="currentColor" />
                                <span>@tomorrowRecipe.TotalTimeMinutes min</span>
                            </span>
                            <span class="todays-dinner-dot" aria-hidden="true">·</span>
                        }
                        <span class="home-meta-item">
                            <FluentIcon Value="@(new Icons.Regular.Size16.People())" Color="Color.Custom" CustomColor="currentColor" />
                            <span>@tomorrowServings @tomorrowRecipe.ServingsUnit</span>
                        </span>
                    </div>
                </div>
                <a href="@($"/recept/{tomorrowRecipe.Id}")" class="btn-secondary-custom btn-sm home-tomorrow-btn">
                    Visa recept →
                </a>
            </div>
        </section>
    }

    @if (hasCalendarService)
    {
        <HomeCalendarSummarySection Today="currentLocalToday"
                                    Occurrences="calendarOccurrences"
                                    IsLoading="isCalendarLoading" />
    }

    <section class="home-shortcuts-section" aria-label="Snabbval">
        <h2 class="home-shortcuts-heading">Snabbval i vardagen</h2>
        <div class="home-shortcuts-grid">
            <a href="/veckomeny" class="home-shortcut-card" id="home-shortcut-weekly-menu">
                <span class="home-shortcut-icon" aria-hidden="true">📅</span>
                <div class="home-shortcut-text">
                    <span class="home-shortcut-title">Veckomeny</span>
                    <span class="home-shortcut-desc">Planera och spika veckans måltider</span>
                </div>
                <span class="home-shortcut-arrow" aria-hidden="true">→</span>
            </a>
            <a href="/inkopslista" class="home-shortcut-card" id="home-shortcut-shopping-list">
                <span class="home-shortcut-icon" aria-hidden="true">🛒</span>
                <div class="home-shortcut-text">
                    <span class="home-shortcut-title">Inköpslista</span>
                    <span class="home-shortcut-desc">Hantera och bocka av dina inköp</span>
                </div>
                <span class="home-shortcut-arrow" aria-hidden="true">→</span>
            </a>
            <a href="/recept" class="home-shortcut-card" id="home-shortcut-recipes">
                <span class="home-shortcut-icon" aria-hidden="true">🍳</span>
                <div class="home-shortcut-text">
                    <span class="home-shortcut-title">Recept</span>
                    <span class="home-shortcut-desc">Sök, filtrera och hitta nya favoriter</span>
                </div>
                <span class="home-shortcut-arrow" aria-hidden="true">→</span>
            </a>
        </div>
    </section>
    </div>
}

@if (ratingTargetRecipe != null)
{
    <RecipeRatingModal IsVisible="showRatingModal"
                       RecipeId="ratingTargetRecipe.Id"
                       RecipeTitle="@ratingTargetRecipe.Title"
                       OnClose="CloseRatingModal"
                       OnRatingChanged="HandleRatingChanged" />
}

@code {
    private static readonly CultureInfo SwedishCulture = CultureInfo.GetCultureInfo("sv-SE");

    private HomeMealPlanDto? mealPlan;
    private IReadOnlyList<CalendarOccurrenceDto> calendarOccurrences = [];
    private DateOnly currentLocalToday;
    private bool isLoading = true;
    private bool isCalendarLoading = false;
    private bool hasCalendarService = false;
    private bool _isDisposed;
    private long _lastCalendarVersion;
    private CalendarService? _calendarService;
    private FamilyMemberNotifier? _familyMemberNotifier;
    private RecipeRatingNotifier? _recipeRatingNotifier;
    private CancellationTokenSource? _midnightWatcherCts;
    private Recipe? ratingTargetRecipe;
    private bool showRatingModal;
    private RecipeRatingSummary? todayRatingSummary;

    protected override async Task OnInitializedAsync()
    {
        var localDateProvider = ServiceProvider.GetService<ILocalDateProvider>() ?? new SwedishLocalDateProvider();
        currentLocalToday = localDateProvider.GetLocalToday();

        _calendarService = ServiceProvider.GetService<CalendarService>();
        hasCalendarService = _calendarService != null;
        if (_calendarService != null)
        {
            _calendarService.Notifier.OnChanged += HandleCalendarChanged;
        }

        _familyMemberNotifier = ServiceProvider.GetService<FamilyMemberNotifier>();
        if (_familyMemberNotifier != null)
        {
            _familyMemberNotifier.OnChanged += HandleFamilyMembersChanged;
        }

        _recipeRatingNotifier = ServiceProvider.GetService<RecipeRatingNotifier>();
        if (_recipeRatingNotifier != null)
        {
            _recipeRatingNotifier.OnChanged += HandleRecipeRatingsChanged;
        }

        await LoadDataAsync();

        _midnightWatcherCts = new CancellationTokenSource();
        _ = StartMidnightWatcherAsync(_midnightWatcherCts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var clientDateStr = await JSRuntime.InvokeAsync<string?>("phew.getClientLocalDate");
                if (DateOnly.TryParseExact(clientDateStr, "yyyy-MM-dd", out var clientDate))
                {
                    var localDateProvider = ServiceProvider.GetService<ILocalDateProvider>();
                    var currentLocal = localDateProvider?.GetLocalToday();
                    localDateProvider?.SetClientLocalDate(clientDate);

                    if (currentLocal != clientDate)
                    {
                        currentLocalToday = clientDate;
                        await LoadDataAsync();
                        StateHasChanged();
                    }
                }
            }
            catch
            {
                // Ignore when prerendering or in bUnit testing
            }
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        var weeklyMenuService = ServiceProvider.GetService<WeeklyMenuService>();
        if (weeklyMenuService != null)
        {
            mealPlan = await weeklyMenuService.GetHomeMealPlanAsync(currentLocalToday);
            todayRatingSummary = mealPlan.TodayMeal.Recipe != null
                ? RecipeRatingSummary.FromRatings(mealPlan.TodayMeal.Recipe.Ratings)
                : null;
        }

        await LoadCalendarDataAsync();
        isLoading = false;
    }

    private async Task LoadCalendarDataAsync()
    {
        if (_calendarService == null)
        {
            calendarOccurrences = [];
            return;
        }

        isCalendarLoading = true;
        try
        {
            var versionBeforeLoad = _calendarService.Notifier.Version;
            calendarOccurrences = await _calendarService.GetWeekOccurrencesAsync(currentLocalToday);
            _lastCalendarVersion = Math.Max(versionBeforeLoad, _calendarService.Notifier.Version);
        }
        finally
        {
            isCalendarLoading = false;
        }
    }

    private void HandleCalendarChanged(long newVersion)
    {
        if (_isDisposed || _calendarService == null)
            return;

        _ = InvokeAsync(async () =>
        {
            if (_isDisposed || newVersion <= _lastCalendarVersion)
                return;

            try
            {
                await LoadCalendarDataAsync();
                StateHasChanged();
            }
            catch (ObjectDisposedException)
            {
                // Ignore if component is disposing
            }
        });
    }

    private void HandleFamilyMembersChanged(long _version)
    {
        if (_isDisposed || _calendarService == null)
            return;

        _ = InvokeAsync(async () =>
        {
            if (_isDisposed)
                return;

            try
            {
                await LoadCalendarDataAsync();
                StateHasChanged();
            }
            catch (ObjectDisposedException)
            {
                // Ignore if component is disposing
            }
        });
    }

    private string GetFormattedDateSubtitle()
    {
        var dayName = CalendarWeek.GetSwedishDayName(currentLocalToday);
        var monthDate = currentLocalToday.ToString("d MMMM", SwedishCulture);
        var week = CalendarWeek.FromDate(currentLocalToday);
        return $"{dayName} {monthDate} · Vecka {week.IsoWeek}";
    }

    private async Task StartMidnightWatcherAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        while (!token.IsCancellationRequested)
        {
            try
            {
                await timer.WaitForNextTickAsync(token);
                var localDateProvider = ServiceProvider.GetService<ILocalDateProvider>() ?? new SwedishLocalDateProvider();
                var latestToday = localDateProvider.GetLocalToday();
                if (latestToday != currentLocalToday)
                {
                    currentLocalToday = latestToday;
                    await LoadDataAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                // Defensive
            }
        }
    }

    private void OpenRatingModal(Recipe recipe)
    {
        ratingTargetRecipe = recipe;
        showRatingModal = true;
    }

    private void CloseRatingModal()
    {
        showRatingModal = false;
    }

    private void HandleRatingChanged(RecipeRatingSummary updatedSummary)
    {
        if (mealPlan?.TodayMeal.Recipe != null &&
            ratingTargetRecipe != null &&
            mealPlan.TodayMeal.Recipe.Id == ratingTargetRecipe.Id)
        {
            todayRatingSummary = updatedSummary;
        }
    }

    private void HandleRecipeRatingsChanged(long _version)
    {
        if (_isDisposed || mealPlan?.TodayMeal.Recipe == null)
            return;

        var ratingService = ServiceProvider.GetService<RecipeRatingService>();
        if (ratingService == null)
            return;

        var todayRecipeId = mealPlan.TodayMeal.Recipe.Id;
        _ = InvokeAsync(async () =>
        {
            if (_isDisposed)
                return;

            try
            {
                todayRatingSummary = await ratingService.GetSummaryAsync(todayRecipeId);
                StateHasChanged();
            }
            catch (ObjectDisposedException)
            {
                // Ignore if component is disposing
            }
        });
    }

    public void Dispose()
    {
        if (_isDisposed)
            return;

        _isDisposed = true;
        if (_calendarService != null)
        {
            _calendarService.Notifier.OnChanged -= HandleCalendarChanged;
        }
        if (_familyMemberNotifier != null)
        {
            _familyMemberNotifier.OnChanged -= HandleFamilyMembersChanged;
        }
        if (_recipeRatingNotifier != null)
        {
            _recipeRatingNotifier.OnChanged -= HandleRecipeRatingsChanged;
        }

        _midnightWatcherCts?.Cancel();
        _midnightWatcherCts?.Dispose();
    }
}
