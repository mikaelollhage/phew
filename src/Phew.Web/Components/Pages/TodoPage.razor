@page "/att-gora"
@implements IDisposable
@inject TodoService TodoService
@inject ILogger<TodoPage> Logger

<PageTitle>Att göra — PHEW!</PageTitle>

@{
    var activeLists = allLists.Where(l => !l.IsArchived).ToList();
    var archivedLists = allLists.Where(l => l.IsArchived).ToList();
    var selectedList = GetSelectedList(activeLists, archivedLists);
}

<div class="todo-page-container">
    <div class="page-header todo-page-header">
        <div>
            <h1 class="page-title">✅ Att göra</h1>
            <p class="page-subtitle">Familjens gemensamma att göra-listor i realtid.</p>
        </div>

        <div class="todo-header-actions">
            <button type="button"
                    id="todo-new-list-toggle-btn"
                    class="btn-primary-custom"
                    @onclick="ToggleCreateListForm">
                @(showCreateListForm ? "Avbryt" : "+ Ny lista")
            </button>

            @if (archivedLists.Count > 0)
            {
                <button type="button"
                        id="todo-toggle-archived-btn"
                        class="btn-secondary-custom @(showArchivedSection ? "is-active" : "")"
                        @onclick="ToggleArchivedSection">
                    📦 Arkiverade (@archivedLists.Count)
                </button>
            }
        </div>
    </div>

    <ContextualFeedback State="feedback" Floating="@feedback.IsSuccess" CssClass="todo-feedback" />

    @if (showCreateListForm)
    {
        <div class="detail-card todo-create-list-card">
            <form class="todo-create-list-form" @onsubmit="CreateListAsync">
                <input id="todo-new-list-input"
                       type="text"
                       class="form-input-custom"
                       maxlength="@TodoList.MaxNameLength"
                       placeholder="Namn på ny lista, t.ex. Helgfix eller Respackning..."
                       aria-label="Namn på ny att göra-lista"
                       @bind="newListName"
                       @bind:event="oninput" />
                <button type="submit"
                        id="todo-create-list-submit-btn"
                        class="btn-primary-custom"
                        disabled="@(isBusy || string.IsNullOrWhiteSpace(newListName))">
                    Skapa lista
                </button>
            </form>
        </div>
    }

    @if (showArchivedSection && archivedLists.Count > 0)
    {
        <div class="detail-card todo-archived-drawer">
            <div class="todo-archived-drawer-header">
                <h2 class="todo-section-heading">📦 Arkiverade listor (@archivedLists.Count)</h2>
            </div>
            <div class="todo-archived-chips">
                @foreach (var archived in archivedLists)
                {
                    var doneCount = archived.Items.Count(i => i.IsCompleted);
                    var totalCount = archived.Items.Count;
                    var isCurrent = selectedList?.Id == archived.Id;
                    <button type="button"
                            @key="archived.Id"
                            class="todo-list-pill is-archived @(isCurrent ? "is-selected" : "")"
                            @onclick="@(() => SelectList(archived.Id))">
                        <span class="todo-list-pill-name">@archived.Name</span>
                        <span class="todo-list-pill-progress">@doneCount/@totalCount</span>
                    </button>
                }
            </div>
        </div>
    }

    @if (openTaskMenuId.HasValue || openListMenuId.HasValue)
    {
        <div class="ingredient-row-menu-backdrop @(openListMenuId.HasValue ? "todo-list-menu-backdrop" : "")"
             @onclick="CloseAllMenus"
             @onclick:stopPropagation="true"></div>
    }

    @if (activeLists.Count > 0)
    {
        <div class="todo-list-tabs" role="tablist" aria-label="Aktiva att göra-listor">
            @for (var listIdx = 0; listIdx < activeLists.Count; listIdx++)
            {
                var list = activeLists[listIdx];
                var doneCount = list.Items.Count(i => i.IsCompleted);
                var totalCount = list.Items.Count;
                var isSelected = selectedList?.Id == list.Id;
                var isMenuOpen = openListMenuId == list.Id;
                var canMoveLeft = listIdx > 0;
                var canMoveRight = listIdx < activeLists.Count - 1;
                var progressPct = totalCount > 0 ? (int)Math.Round(doneCount * 100.0 / totalCount) : 0;

                <div @key="list.Id"
                     class="todo-list-pill @(isSelected ? "is-selected" : "") @(isMenuOpen ? "is-menu-open" : "")"
                     data-todo-list-id="@list.Id">
                    <div class="todo-list-pill-top">
                        <button type="button"
                                role="tab"
                                aria-selected="@(isSelected ? "true" : "false")"
                                class="todo-list-pill-select"
                                @onclick="@(() => SelectList(list.Id))">
                            <span class="todo-list-pill-name">@list.Name</span>
                            <span class="todo-list-pill-progress">@doneCount/@totalCount</span>
                        </button>

                        <div class="ingredient-row-menu-anchor todo-list-menu-anchor @(isMenuOpen ? "is-open" : "")"
                             @onkeydown="@(e => HandleListMenuKeyDown(e, list.Id))">
                            <button type="button"
                                    class="btn-secondary-custom ingredient-row-menu-btn todo-list-menu-btn @(isMenuOpen ? "is-active" : "")"
                                    title="Åtgärder för lista"
                                    aria-label="@($"Åtgärder för {list.Name}")"
                                    aria-haspopup="menu"
                                    aria-expanded="@(isMenuOpen ? "true" : "false")"
                                    @onclick="@(() => ToggleListMenu(list.Id))"
                                    @onclick:stopPropagation="true">
                                <FluentIcon Value="@(new Icons.Regular.Size16.MoreHorizontal())" Color="Color.Custom" CustomColor="currentColor" />
                            </button>

                            @if (isMenuOpen)
                            {
                                <div class="ingredient-row-menu-popover todo-list-menu-popover"
                                     role="menu"
                                     aria-label="@($"Åtgärder för {list.Name}")"
                                     @onclick:stopPropagation="true">
                                    <button type="button"
                                            role="menuitem"
                                            class="ingredient-row-menu-item todo-list-move-left-btn"
                                            disabled="@(!canMoveLeft || isBusy)"
                                            @onclick="@(() => MoveListAsync(list.Id, -1))">
                                        <span class="ingredient-row-menu-icon" aria-hidden="true">←</span>
                                        <span>Flytta vänster</span>
                                    </button>
                                    <button type="button"
                                            role="menuitem"
                                            class="ingredient-row-menu-item todo-list-move-right-btn"
                                            disabled="@(!canMoveRight || isBusy)"
                                            @onclick="@(() => MoveListAsync(list.Id, 1))">
                                        <span class="ingredient-row-menu-icon" aria-hidden="true">→</span>
                                        <span>Flytta höger</span>
                                    </button>
                                    <FluentDivider Role="DividerRole.Separator" Class="ingredient-row-menu-separator" />
                                    <button type="button"
                                            role="menuitem"
                                            class="ingredient-row-menu-item todo-list-rename-btn"
                                            disabled="@isBusy"
                                            @onclick="@(() => StartRenameList(list))">
                                        <span class="ingredient-row-menu-icon" aria-hidden="true">✏️</span>
                                        <span>Byt namn</span>
                                    </button>
                                    <button type="button"
                                            role="menuitem"
                                            class="ingredient-row-menu-item todo-list-archive-btn"
                                            disabled="@isBusy"
                                            @onclick="@(() => ArchiveListAsync(list.Id))">
                                        <span class="ingredient-row-menu-icon" aria-hidden="true">📦</span>
                                        <span>Arkivera lista</span>
                                    </button>
                                    <button type="button"
                                            role="menuitem"
                                            class="ingredient-row-menu-item todo-list-delete-btn"
                                            disabled="@isBusy"
                                            @onclick="@(() => RequestDeleteList(list))">
                                        <span class="ingredient-row-menu-icon" aria-hidden="true">🗑️</span>
                                        <span>Ta bort lista</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                    <span class="todo-list-pill-bar" aria-hidden="true">
                        <span class="todo-list-pill-bar-fill" style="width: @($"{progressPct}%")"></span>
                    </span>
                </div>
            }
        </div>
    }

    @if (isLoading)
    {
        <div class="detail-card todo-empty-state">
            <p>Laddar att göra-listor...</p>
        </div>
    }
    else if (allLists.Count == 0)
    {
        <div class="detail-card todo-empty-state">
            <div class="todo-empty-icon" aria-hidden="true">📝</div>
            <h2>Inga att göra-listor ännu</h2>
            <p>Skapa din första lista för att komma igång med familjens uppgifter.</p>
            @if (!showCreateListForm)
            {
                <button type="button"
                        class="btn-primary-custom"
                        @onclick="ToggleCreateListForm">
                    + Skapa första listan
                </button>
            }
        </div>
    }
    else if (selectedList == null)
    {
        <div class="detail-card todo-empty-state">
            <div class="todo-empty-icon" aria-hidden="true">📦</div>
            <h2>Alla listor är arkiverade</h2>
            <p>Skapa en ny lista eller öppna en arkiverad lista ovan för att återställa den.</p>
            <div class="todo-empty-actions">
                <button type="button" class="btn-primary-custom" @onclick="ToggleCreateListForm">
                    + Ny lista
                </button>
                <button type="button" class="btn-secondary-custom" @onclick="@(() => showArchivedSection = true)">
                    Visa arkiverade (@archivedLists.Count)
                </button>
            </div>
        </div>
    }
    else
    {
        var allItems = selectedList.Items
            .OrderBy(i => i.SortOrder)
            .ThenBy(i => i.Id)
            .ToList();
        var openItems = allItems.Where(i => !i.IsCompleted).ToList();
        var completedItems = allItems.Where(i => i.IsCompleted).ToList();
        var totalCount = allItems.Count;
        var doneCount = completedItems.Count;
        var progressPct = totalCount > 0 ? (int)Math.Round(doneCount * 100.0 / totalCount) : 0;

        <div class="detail-card todo-active-list-card">
            @if (selectedList.IsArchived)
            {
                <div class="todo-archived-banner" role="status">
                    <div>
                        <strong>📦 Arkiverad lista (skrivskyddad)</strong>
                        <p>Återställ listan för att lägga till, ändra eller bocka av uppgifter.</p>
                    </div>
                    <div class="todo-archived-banner-actions">
                        <button type="button"
                                id="todo-restore-list-btn"
                                class="btn-primary-custom"
                                disabled="@isBusy"
                                @onclick="@(() => RestoreListAsync(selectedList.Id))">
                            ↩️ Återställ lista
                        </button>
                        <button type="button"
                                id="todo-delete-list-btn"
                                class="btn-danger-custom"
                                disabled="@isBusy"
                                @onclick="@(() => RequestDeleteList(selectedList))">
                            🗑️ Ta bort
                        </button>
                    </div>
                </div>
            }

            <div class="todo-list-toolbar">
                <div class="todo-list-title-block">
                    @if (isRenamingList && !selectedList.IsArchived)
                    {
                        <form class="todo-rename-list-form" @onsubmit="@(() => SaveListRenameAsync(selectedList.Id))">
                            <input id="todo-rename-list-input"
                                   type="text"
                                   class="form-input-custom"
                                   maxlength="@TodoList.MaxNameLength"
                                   aria-label="Nytt namn på listan"
                                   @bind="renameListDraft"
                                   @bind:event="oninput" />
                            <button type="submit"
                                    id="todo-rename-list-save-btn"
                                    class="btn-primary-custom"
                                    disabled="@(isBusy || string.IsNullOrWhiteSpace(renameListDraft))">
                                Spara
                            </button>
                            <button type="button"
                                    class="btn-secondary-custom"
                                    @onclick="CancelRenameList">
                                Avbryt
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="todo-list-title-row">
                            <h2 class="todo-active-list-title">@selectedList.Name</h2>
                            <span class="todo-progress-badge">@doneCount av @totalCount klara</span>
                        </div>
                        <div class="todo-progress-track" aria-hidden="true">
                            <div class="todo-progress-fill" style="width: @($"{progressPct}%")"></div>
                        </div>
                    }
                </div>
            </div>

            @if (!selectedList.IsArchived)
            {
                <form class="todo-quick-add-form" @onsubmit="@(() => AddItemAsync(selectedList.Id))">
                    <input id="todo-quick-add-input"
                           type="text"
                           class="form-input-custom todo-quick-add-input"
                           maxlength="@TodoItem.MaxTitleLength"
                           placeholder="Lägg till uppgift..."
                           enterkeyhint="done"
                           aria-label="Lägg till ny uppgift"
                           @bind="newItemTitle"
                           @bind:event="oninput" />
                    <button type="submit"
                            id="todo-quick-add-btn"
                            class="btn-primary-custom todo-quick-add-btn"
                            disabled="@(isBusy || string.IsNullOrWhiteSpace(newItemTitle))">
                        + Lägg till
                    </button>
                </form>
            }

            @if (totalCount == 0)
            {
                <div class="todo-list-empty-tasks">
                    <p>Inga uppgifter i den här listan ännu. Lägg till den första uppgiften ovan!</p>
                </div>
            }
            else
            {
                <section class="todo-task-section" aria-label="Att göra">
                    <div class="todo-section-header">
                        <h3 class="todo-section-heading">Att göra (@openItems.Count)</h3>
                    </div>

                    @if (openItems.Count == 0)
                    {
                        <div class="todo-all-done-hint">
                            <span>Allt är klart! 🎉</span>
                        </div>
                    }
                    else
                    {
                        <div class="todo-task-list">
                            @for (var idx = 0; idx < openItems.Count; idx++)
                            {
                                var item = openItems[idx];
                                @RenderTaskRow(item, idx, openItems.Count, selectedList.IsArchived)
                            }
                        </div>
                    }
                </section>

                @if (completedItems.Count > 0)
                {
                    <section class="todo-task-section todo-completed-section" aria-label="Klara">
                        <div class="todo-section-header">
                            <h3 class="todo-section-heading">Klara (@completedItems.Count)</h3>
                            @if (!selectedList.IsArchived)
                            {
                                <button type="button"
                                        id="todo-clear-completed-btn"
                                        class="btn-secondary-custom todo-clear-completed-btn"
                                        disabled="@isBusy"
                                        @onclick="@(() => ClearCompletedAsync(selectedList.Id))">
                                    Rensa klara
                                </button>
                            }
                        </div>

                        <div class="todo-task-list">
                            @for (var idx = 0; idx < completedItems.Count; idx++)
                            {
                                var item = completedItems[idx];
                                @RenderTaskRow(item, idx, completedItems.Count, selectedList.IsArchived)
                            }
                        </div>
                    </section>
                }
            }
        </div>
    }
</div>

<ConfirmDialog IsVisible="listPendingDelete != null"
               Title="Ta bort att göra-lista"
               Message="@(listPendingDelete != null ? $"Är du säker på att du vill ta bort listan \"{listPendingDelete.Name}\" och alla dess uppgifter permanent?" : string.Empty)"
               ConfirmText="Ja, ta bort"
               CancelText="Avbryt"
               Variant="ConfirmDialogVariant.Danger"
               OnConfirm="ConfirmDeleteListAsync"
               OnCancel="@(() => listPendingDelete = null)" />

@code {
    private List<TodoList> allLists = new();
    private int? selectedListId;
    private bool isLoading = true;
    private bool isBusy;
    private bool showCreateListForm;
    private bool showArchivedSection;
    private string newListName = string.Empty;
    private string newItemTitle = string.Empty;

    private bool isRenamingList;
    private string renameListDraft = string.Empty;

    private int? editingItemId;
    private string editItemTitle = string.Empty;
    private string editItemNotes = string.Empty;
    private bool showEditItemNotes;

    private int? openListMenuId;
    private int? openTaskMenuId;
    private TodoList? listPendingDelete;

    private readonly FeedbackState feedback = new();
    private long _lastLoadedVersion;
    private bool _isDisposed;

    protected override async Task OnInitializedAsync()
    {
        TodoService.OnChanged += HandleTodoChanged;
        await ReloadAsync();
        isLoading = false;
    }

    private RenderFragment RenderTaskRow(TodoItem item, int groupIndex, int groupCount, bool isReadOnly) => __builder =>
    {
        var isEditing = !isReadOnly && editingItemId == item.Id;
        var isMenuOpen = !isReadOnly && openTaskMenuId == item.Id;
        var canMoveUp = groupIndex > 0;
        var canMoveDown = groupIndex < groupCount - 1;

        <div @key="item.Id"
             class="todo-task-row @(item.IsCompleted ? "is-completed" : "") @(isEditing ? "is-editing" : "")"
             data-todo-item-id="@item.Id">
            <button type="button"
                    class="todo-check-btn @(item.IsCompleted ? "is-checked" : "")"
                    disabled="@(isReadOnly || isBusy)"
                    aria-label="@(item.IsCompleted ? $"Återöppna {item.Title}" : $"Markera {item.Title} som klar")"
                    aria-pressed="@(item.IsCompleted ? "true" : "false")"
                    @onclick="@(() => ToggleItemCompletedAsync(item))">
                @if (item.IsCompleted)
                {
                    <span class="todo-check-mark" aria-hidden="true">✓</span>
                }
            </button>

            <div class="todo-task-content">
                @if (isEditing)
                {
                    <div class="todo-inline-edit-form" @onkeydown="@(e => HandleEditKeyDown(e, item.Id))">
                        <div class="todo-inline-edit-primary">
                            <input type="text"
                                   class="form-input-custom todo-inline-edit-title"
                                   maxlength="@TodoItem.MaxTitleLength"
                                   aria-label="Uppgiftens titel"
                                   @bind="editItemTitle"
                                   @bind:event="oninput" />
                            <div class="todo-inline-edit-actions">
                                <button type="button"
                                        class="btn-primary-custom todo-edit-save-btn"
                                        disabled="@(isBusy || string.IsNullOrWhiteSpace(editItemTitle))"
                                        @onclick="@(() => SaveTaskEditAsync(item.Id))">
                                    Spara
                                </button>
                                <button type="button"
                                        class="btn-secondary-custom todo-edit-cancel-btn"
                                        @onclick="CancelEditTask">
                                    Avbryt
                                </button>
                            </div>
                        </div>
                        @if (showEditItemNotes)
                        {
                            <input type="text"
                                   class="form-input-custom todo-inline-edit-notes"
                                   maxlength="@TodoItem.MaxNotesLength"
                                   placeholder="Anteckning (valfri)"
                                   aria-label="Anteckning"
                                   @bind="editItemNotes"
                                   @bind:event="oninput" />
                        }
                        else
                        {
                            <div class="todo-inline-edit-secondary">
                                <button type="button"
                                        class="todo-edit-notes-toggle"
                                        @onclick="ExpandEditNotes">
                                    + Lägg till anteckning
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="todo-task-title">@item.Title</div>
                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                    {
                        <div class="todo-task-notes">@item.Notes</div>
                    }
                }
            </div>

            @if (!isReadOnly && !isEditing)
            {
                <div class="ingredient-row-menu-anchor @(isMenuOpen ? "is-open" : "")"
                     @onkeydown="@(e => HandleTaskMenuKeyDown(e, item.Id))">
                    <button type="button"
                            class="btn-secondary-custom ingredient-row-menu-btn todo-task-menu-btn @(isMenuOpen ? "is-active" : "")"
                            title="Åtgärder"
                            aria-label="@($"Åtgärder för {item.Title}")"
                            aria-haspopup="menu"
                            aria-expanded="@(isMenuOpen ? "true" : "false")"
                            @onclick="@(() => ToggleTaskMenu(item.Id))"
                            @onclick:stopPropagation="true">
                        <FluentIcon Value="@(new Icons.Regular.Size16.MoreHorizontal())" Color="Color.Custom" CustomColor="currentColor" />
                    </button>

                    @if (isMenuOpen)
                    {
                        <div class="ingredient-row-menu-popover"
                             role="menu"
                             aria-label="@($"Åtgärder för {item.Title}")"
                             @onclick:stopPropagation="true">
                            <button type="button"
                                    role="menuitem"
                                    class="ingredient-row-menu-item todo-move-up-btn"
                                    disabled="@(!canMoveUp || isBusy)"
                                    @onclick="@(() => MoveTaskAsync(item.Id, -1))">
                                <span class="ingredient-row-menu-icon" aria-hidden="true">↑</span>
                                <span>Flytta upp</span>
                            </button>
                            <button type="button"
                                    role="menuitem"
                                    class="ingredient-row-menu-item todo-move-down-btn"
                                    disabled="@(!canMoveDown || isBusy)"
                                    @onclick="@(() => MoveTaskAsync(item.Id, 1))">
                                <span class="ingredient-row-menu-icon" aria-hidden="true">↓</span>
                                <span>Flytta ned</span>
                            </button>
                            <FluentDivider Role="DividerRole.Separator" Class="ingredient-row-menu-separator" />
                            <button type="button"
                                    role="menuitem"
                                    class="ingredient-row-menu-item todo-edit-task-btn"
                                    disabled="@isBusy"
                                    @onclick="@(() => StartEditTask(item))">
                                <span class="ingredient-row-menu-icon" aria-hidden="true">✏️</span>
                                <span>Redigera</span>
                            </button>
                            <button type="button"
                                    role="menuitem"
                                    class="ingredient-row-menu-item todo-delete-task-btn"
                                    disabled="@isBusy"
                                    @onclick="@(() => DeleteTaskAsync(item.Id))">
                                <span class="ingredient-row-menu-icon" aria-hidden="true">🗑️</span>
                                <span>Ta bort</span>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    };

    private async Task ReloadAsync()
    {
        var versionBefore = TodoService.CurrentVersion;
        allLists = await TodoService.GetAllListsAsync(includeArchived: true);
        _lastLoadedVersion = Math.Max(versionBefore, TodoService.CurrentVersion);

        if (selectedListId.HasValue && allLists.All(l => l.Id != selectedListId.Value))
        {
            selectedListId = null;
        }

        if (openListMenuId.HasValue && allLists.All(l => l.Id != openListMenuId.Value || l.IsArchived))
        {
            openListMenuId = null;
        }

        if (!selectedListId.HasValue)
        {
            selectedListId = allLists.FirstOrDefault(l => !l.IsArchived)?.Id;
        }
    }

    private TodoList? GetSelectedList(List<TodoList> activeLists, List<TodoList> archivedLists)
    {
        if (selectedListId.HasValue)
        {
            var match = allLists.FirstOrDefault(l => l.Id == selectedListId.Value);
            if (match != null)
            {
                return match;
            }
        }

        return activeLists.FirstOrDefault();
    }

    private void SelectList(int listId)
    {
        selectedListId = listId;
        isRenamingList = false;
        editingItemId = null;
        openTaskMenuId = null;
        openListMenuId = null;
        feedback.Clear();
    }

    private void ToggleCreateListForm()
    {
        openTaskMenuId = null;
        openListMenuId = null;
        showCreateListForm = !showCreateListForm;
        if (!showCreateListForm)
        {
            newListName = string.Empty;
        }
    }

    private void ToggleArchivedSection()
    {
        openTaskMenuId = null;
        openListMenuId = null;
        showArchivedSection = !showArchivedSection;
    }

    private async Task CreateListAsync()
    {
        if (string.IsNullOrWhiteSpace(newListName))
            return;

        await RunActionAsync(async () =>
        {
            var created = await TodoService.CreateListAsync(newListName);
            newListName = string.Empty;
            showCreateListForm = false;
            selectedListId = created.Id;
            await ReloadAsync();
        });
    }

    private void StartRenameList(TodoList list)
    {
        selectedListId = list.Id;
        isRenamingList = true;
        renameListDraft = list.Name;
        openTaskMenuId = null;
        openListMenuId = null;
    }

    private void CancelRenameList()
    {
        isRenamingList = false;
        renameListDraft = string.Empty;
    }

    private async Task SaveListRenameAsync(int listId)
    {
        if (string.IsNullOrWhiteSpace(renameListDraft))
            return;

        await RunActionAsync(async () =>
        {
            await TodoService.RenameListAsync(listId, renameListDraft);
            isRenamingList = false;
            renameListDraft = string.Empty;
            await ReloadAsync();
        });
    }

    private async Task MoveListAsync(int listId, int direction)
    {
        // Keep openListMenuId intact so the floating menu stays open and follows the list tab.
        await RunActionAsync(async () =>
        {
            await TodoService.MoveListAsync(listId, direction);
            await ReloadAsync();
        });
    }

    private async Task ArchiveListAsync(int listId)
    {
        openListMenuId = null;
        openTaskMenuId = null;
        await RunActionAsync(async () =>
        {
            await TodoService.ArchiveListAsync(listId);
            isRenamingList = false;
            editingItemId = null;
            await ReloadAsync();
            if (selectedListId == listId)
            {
                selectedListId = allLists.FirstOrDefault(l => !l.IsArchived)?.Id;
            }
            feedback.ShowSuccess("Listan har arkiverats.");
        });
    }

    private async Task RestoreListAsync(int listId)
    {
        await RunActionAsync(async () =>
        {
            await TodoService.RestoreListAsync(listId);
            selectedListId = listId;
            await ReloadAsync();
            if (allLists.All(l => !l.IsArchived))
            {
                showArchivedSection = false;
            }
            feedback.ShowSuccess("Listan har återställts.");
        });
    }

    private void RequestDeleteList(TodoList list)
    {
        listPendingDelete = list;
        openTaskMenuId = null;
        openListMenuId = null;
    }

    private async Task ConfirmDeleteListAsync()
    {
        var target = listPendingDelete;
        listPendingDelete = null;
        if (target == null)
            return;

        await RunActionAsync(async () =>
        {
            await TodoService.DeleteListAsync(target.Id);
            await ReloadAsync();
            feedback.ShowSuccess($"Listan \"{target.Name}\" togs bort.");
        });
    }

    private async Task AddItemAsync(int listId)
    {
        if (string.IsNullOrWhiteSpace(newItemTitle))
            return;

        await RunActionAsync(async () =>
        {
            await TodoService.AddItemAsync(listId, newItemTitle);
            newItemTitle = string.Empty;
            await ReloadAsync();
        });
    }

    private async Task ToggleItemCompletedAsync(TodoItem item)
    {
        openTaskMenuId = null;
        await RunActionAsync(async () =>
        {
            await TodoService.SetItemCompletedAsync(item.Id, !item.IsCompleted);
            await ReloadAsync();
        });
    }

    private void ToggleListMenu(int listId)
    {
        openTaskMenuId = null;
        openListMenuId = openListMenuId == listId ? null : listId;
    }

    private void HandleListMenuKeyDown(KeyboardEventArgs e, int listId)
    {
        if (e.Key == "Escape" && openListMenuId == listId)
        {
            openListMenuId = null;
        }
    }

    private void ToggleTaskMenu(int itemId)
    {
        openListMenuId = null;
        openTaskMenuId = openTaskMenuId == itemId ? null : itemId;
    }

    private void CloseAllMenus()
    {
        openListMenuId = null;
        openTaskMenuId = null;
    }

    private void HandleTaskMenuKeyDown(KeyboardEventArgs e, int itemId)
    {
        if (e.Key == "Escape" && openTaskMenuId == itemId)
        {
            openTaskMenuId = null;
        }
    }

    private async Task MoveTaskAsync(int itemId, int direction)
    {
        // Keep openTaskMenuId intact so the floating menu stays open and follows the task.
        await RunActionAsync(async () =>
        {
            await TodoService.MoveItemAsync(itemId, direction);
            await ReloadAsync();
        });
    }

    private void StartEditTask(TodoItem item)
    {
        openListMenuId = null;
        openTaskMenuId = null;
        editingItemId = item.Id;
        editItemTitle = item.Title;
        editItemNotes = item.Notes ?? string.Empty;
        showEditItemNotes = !string.IsNullOrWhiteSpace(item.Notes);
    }

    private void ExpandEditNotes()
    {
        showEditItemNotes = true;
    }

    private void CancelEditTask()
    {
        editingItemId = null;
        editItemTitle = string.Empty;
        editItemNotes = string.Empty;
        showEditItemNotes = false;
    }

    private async Task HandleEditKeyDown(KeyboardEventArgs e, int itemId)
    {
        if (e.Key == "Escape")
        {
            CancelEditTask();
        }
        else if (e.Key == "Enter")
        {
            await SaveTaskEditAsync(itemId);
        }
    }

    private async Task SaveTaskEditAsync(int itemId)
    {
        if (string.IsNullOrWhiteSpace(editItemTitle))
            return;

        await RunActionAsync(async () =>
        {
            await TodoService.UpdateItemAsync(itemId, editItemTitle, editItemNotes);
            CancelEditTask();
            await ReloadAsync();
        });
    }

    private async Task DeleteTaskAsync(int itemId)
    {
        if (openTaskMenuId == itemId)
        {
            openTaskMenuId = null;
        }

        await RunActionAsync(async () =>
        {
            await TodoService.DeleteItemAsync(itemId);
            await ReloadAsync();
        });
    }

    private async Task ClearCompletedAsync(int listId)
    {
        openTaskMenuId = null;
        await RunActionAsync(async () =>
        {
            await TodoService.ClearCompletedItemsAsync(listId);
            await ReloadAsync();
        });
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        if (isBusy)
            return;

        isBusy = true;
        feedback.Clear();
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or KeyNotFoundException)
        {
            feedback.ShowError(ex.Message);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ett fel uppstod vid uppdatering av att göra-listan.");
            feedback.ShowError("Ett oväntat fel uppstod. Försök igen.");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void HandleTodoChanged(long newVersion)
    {
        if (_isDisposed)
            return;

        _ = InvokeAsync(async () =>
        {
            if (_isDisposed || newVersion <= _lastLoadedVersion)
                return;

            try
            {
                await ReloadAsync();
                StateHasChanged();
            }
            catch (Exception ex) when (!_isDisposed)
            {
                Logger.LogWarning(ex, "Kunde inte uppdatera att göra-listan vid realtidshändelse.");
            }
        });
    }

    public void Dispose()
    {
        _isDisposed = true;
        TodoService.OnChanged -= HandleTodoChanged;
    }
}
