<section class="weekly-day-card calendar-day-card @(IsToday ? "is-today" : "") @(OrderedOccurrences.Count == 0 ? "is-empty" : "has-events")"
         data-date="@Date.ToString("yyyy-MM-dd")"
         aria-label="@CalendarWeek.FormatDayHeaderSwedish(Date)">
    <div class="weekly-day-header calendar-day-header">
        <div class="weekly-day-title-group">
            <span class="weekly-day-name">@CalendarWeek.FormatDayHeaderSwedish(Date)</span>
            @if (IsToday)
            {
                <span class="weekly-day-today-badge">IDAG</span>
            }
        </div>

        <button type="button"
                class="btn-secondary-custom btn-sm calendar-day-add-btn"
                title="@($"Lägg till händelse {CalendarWeek.GetSwedishDayName(Date).ToLower(CalendarDisplayHelper.SwedishCulture)}")"
                @onclick="HandleAddClicked">
            + Händelse
        </button>
    </div>

    @if (OrderedOccurrences.Count == 0)
    {
        <div class="calendar-day-empty">
            <span class="calendar-day-empty-text">Inga händelser planerade.</span>
        </div>
    }
    else
    {
        <ul class="calendar-events-list" aria-label="@($"Händelser {CalendarWeek.GetSwedishDayName(Date)}")">
            @foreach (var occurrence in OrderedOccurrences)
            {
                var timeLabel = CalendarDisplayHelper.FormatTimeRange(occurrence.IsAllDay, occurrence.StartTime, occurrence.EndTime);
                var reminderLabel = CalendarDisplayHelper.FormatReminderLabel(occurrence.IsAllDay, occurrence.ReminderMinutesBefore);
                var occurrenceKey = CalendarDisplayHelper.GetOccurrenceKey(occurrence);
                var isExpanded = ExpandedOccurrenceKeys?.Contains(occurrenceKey) == true;
                var hasDetailsMeta = !string.IsNullOrWhiteSpace(occurrence.Location) ||
                                     occurrence.FamilyMembers.Count >= 2 ||
                                     !string.IsNullOrWhiteSpace(occurrence.Notes);

                <li class="calendar-event-item @(occurrence.IsAllDay ? "is-all-day" : "is-timed") @(isExpanded ? "is-expanded" : "")"
                    data-event-id="@occurrence.CalendarEventId"
                    data-occurrence-key="@occurrenceKey">
                    <button type="button"
                            class="calendar-event-summary-btn @(isExpanded ? "is-expanded" : "")"
                            aria-expanded="@(isExpanded ? "true" : "false")"
                            aria-label="@(isExpanded ? $"Dölj detaljer för {occurrence.Title}" : $"Visa detaljer för {occurrence.Title}")"
                            @onclick="@(() => HandleToggleExpandedClicked(occurrenceKey))">
                        <span class="calendar-event-primary-main">
                            <span class="calendar-event-time-badge @(occurrence.IsAllDay ? "is-all-day" : "")">
                                @timeLabel
                            </span>

                            <span class="calendar-event-title">@occurrence.Title</span>

                            @if (occurrence.IsRecurring || occurrence.ReminderMinutesBefore.HasValue)
                            {
                                <span class="calendar-event-indicators">
                                    @if (occurrence.IsRecurring)
                                    {
                                        var recurrenceTooltip = CalendarDisplayHelper.FormatRecurrenceSummary(
                                            occurrence.RecurrenceIntervalWeeks,
                                            occurrence.RecurrenceDaysOfWeekMask);
                                        <span class="calendar-indicator-badge calendar-recurring-indicator"
                                              title="@($"Återkommande: {recurrenceTooltip}")"
                                              aria-label="@($"Återkommande: {recurrenceTooltip}")">
                                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" Color="Color.Custom" CustomColor="currentColor" />
                                        </span>
                                    }
                                    @if (occurrence.ReminderMinutesBefore.HasValue)
                                    {
                                        <span class="calendar-indicator-badge"
                                              title="@($"Påminnelse: {reminderLabel}")"
                                              aria-label="@($"Påminnelse: {reminderLabel}")">
                                            🔔
                                        </span>
                                    }
                                </span>
                            }

                            @if (occurrence.FamilyMembers.Count == 1)
                            {
                                <span class="calendar-event-person-badge" title="@occurrence.FamilyMembers[0]">
                                    @occurrence.FamilyMembers[0]
                                </span>
                            }
                            else if (occurrence.FamilyMembers.Count >= 2)
                            {
                                var membersTooltip = string.Join(", ", occurrence.FamilyMembers);
                                <span class="calendar-event-person-badge is-count"
                                      title="@membersTooltip"
                                      aria-label="@($"{occurrence.FamilyMembers.Count} personer: {membersTooltip}")">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Person())" Color="Color.Custom" CustomColor="currentColor" />
                                    <span>@occurrence.FamilyMembers.Count</span>
                                </span>
                            }
                        </span>

                        <span class="calendar-event-chevron @(isExpanded ? "is-expanded" : "")" aria-hidden="true">
                            @if (isExpanded)
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size16.ChevronUp())" Color="Color.Custom" CustomColor="currentColor" />
                            }
                            else
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size16.ChevronDown())" Color="Color.Custom" CustomColor="currentColor" />
                            }
                        </span>
                    </button>

                    @if (isExpanded)
                    {
                        <div class="calendar-event-details">
                            @if (hasDetailsMeta)
                            {
                                <div class="calendar-event-details-meta">
                                    @if (!string.IsNullOrWhiteSpace(occurrence.Location))
                                    {
                                        <div class="calendar-event-detail-row calendar-event-location">
                                            <span class="calendar-event-detail-icon" aria-hidden="true">
                                                <FluentIcon Value="@(new Icons.Regular.Size16.Location())" Color="Color.Custom" CustomColor="currentColor" />
                                            </span>
                                            <span>@occurrence.Location</span>
                                        </div>
                                    }
                                    @if (occurrence.FamilyMembers.Count >= 2)
                                    {
                                        <div class="calendar-event-detail-row calendar-event-members" aria-label="Tilldelade personer">
                                            <span class="calendar-event-detail-icon" aria-hidden="true">
                                                <FluentIcon Value="@(new Icons.Regular.Size16.People())" Color="Color.Custom" CustomColor="currentColor" />
                                            </span>
                                            <div class="calendar-event-members-list">
                                                @foreach (var member in occurrence.FamilyMembers)
                                                {
                                                    <span class="calendar-member-chip">@member</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(occurrence.Notes))
                                    {
                                        <p class="calendar-event-notes">@occurrence.Notes</p>
                                    }
                                </div>
                            }

                            <div class="calendar-event-details-actions">
                                <button type="button"
                                        class="btn-secondary-custom btn-sm calendar-event-edit-btn"
                                        @onclick="@(() => HandleEditClicked(occurrence))">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="Color.Custom" CustomColor="currentColor" />
                                    <span>Redigera</span>
                                </button>
                                <button type="button"
                                        class="btn-secondary-custom btn-sm calendar-event-delete-btn"
                                        @onclick="@(() => HandleDeleteClicked(occurrence))">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Custom" CustomColor="currentColor" />
                                    <span>Radera</span>
                                </button>
                            </div>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public DateOnly Date { get; set; }
    [Parameter] public bool IsToday { get; set; }
    [Parameter] public IReadOnlyList<CalendarOccurrenceDto> Occurrences { get; set; } = [];
    [Parameter] public IReadOnlySet<string>? ExpandedOccurrenceKeys { get; set; }
    [Parameter] public EventCallback<string> OnToggleEventExpanded { get; set; }
    [Parameter] public EventCallback<DateOnly> OnAddEvent { get; set; }
    [Parameter] public EventCallback<CalendarOccurrenceDto> OnEditEvent { get; set; }
    [Parameter] public EventCallback<CalendarOccurrenceDto> OnDeleteEvent { get; set; }

    private IReadOnlyList<CalendarOccurrenceDto> OrderedOccurrences => Occurrences
        .OrderBy(o => o.IsAllDay ? 0 : 1)
        .ThenBy(o => o.StartTime)
        .ThenBy(o => o.EndTime)
        .ThenBy(o => o.Title, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private Task HandleToggleExpandedClicked(string occurrenceKey) =>
        OnToggleEventExpanded.HasDelegate ? OnToggleEventExpanded.InvokeAsync(occurrenceKey) : Task.CompletedTask;

    private Task HandleAddClicked() =>
        OnAddEvent.HasDelegate ? OnAddEvent.InvokeAsync(Date) : Task.CompletedTask;

    private Task HandleEditClicked(CalendarOccurrenceDto occurrence) =>
        OnEditEvent.HasDelegate ? OnEditEvent.InvokeAsync(occurrence) : Task.CompletedTask;

    private Task HandleDeleteClicked(CalendarOccurrenceDto occurrence) =>
        OnDeleteEvent.HasDelegate ? OnDeleteEvent.InvokeAsync(occurrence) : Task.CompletedTask;
}
