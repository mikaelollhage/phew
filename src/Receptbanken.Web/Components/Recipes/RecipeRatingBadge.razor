@using Receptbanken.Core.Models

<button type="button"
        class="recipe-rating-badge @(Summary.HasRatings ? "is-rated" : "is-unrated") @CssClass"
        aria-label="@AriaLabel"
        title="@AriaLabel"
        @onclick="OnClick">
    @if (Summary.HasRatings)
    {
        <span class="recipe-rating-badge-star is-filled" aria-hidden="true">★</span>
        <span class="recipe-rating-badge-score">@Summary.FormatAverageSwedish()</span>
        <span class="recipe-rating-badge-votes">(@Summary.FormatVoteCountSwedish())</span>
    }
    else
    {
        <span class="recipe-rating-badge-star is-empty" aria-hidden="true">☆</span>
        <span class="recipe-rating-badge-cta">Betygsätt</span>
    }
</button>

@code {
    [Parameter] public RecipeRatingSummary Summary { get; set; } = RecipeRatingSummary.Empty;
    [Parameter] public string RecipeTitle { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string? CssClass { get; set; }

    private string AriaLabel => Summary.HasRatings
        ? $"Betyg {Summary.FormatAverageSwedish()} av 5 ({Summary.FormatVoteCountSwedish()}) för {RecipeTitle}. Klicka för att betygsätta."
        : $"Inga betyg ännu för {RecipeTitle}. Klicka för att betygsätta.";
}
