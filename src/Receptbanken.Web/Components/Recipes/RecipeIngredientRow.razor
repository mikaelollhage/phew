@namespace Receptbanken.Web.Components.Recipes

@if (Ingredient != null)
{
    <div class="ingredient-editor-row @(DragHandle != null ? "has-drag-handle" : "") @(RowActions != null ? "has-row-actions" : "")">
        @if (DragHandle != null)
        {
            <div class="ingredient-row-drag">
                @DragHandle
            </div>
        }
        <div class="ingredient-editor-fields @(showOptionalFields ? "has-optional-expanded" : "")">
            <FluentTextField Id="@FirstInputId" @bind-Value="QuantityDisplay" Placeholder="Mängd" Title="Mängd" Style="width: 100%;" />
            <FluentTextField @bind-Value="Ingredient.Unit" Immediate="true" ImmediateDelay="250" Placeholder="Enhet" Title="Enhet" Style="width: 100%;" />
            <FluentTextField @bind-Value="Ingredient.Name" Immediate="true" ImmediateDelay="250" Placeholder="Råvara *" Title="Råvara" Style="width: 100%;" />
            <button type="button"
                    class="ingredient-optional-toggle @(HasOptionalValues && !showOptionalFields ? "has-values" : "")"
                    aria-expanded="@(showOptionalFields ? "true" : "false")"
                    aria-label="@OptionalToggleAriaLabel"
                    title="@OptionalToggleTitle"
                    @onclick="ToggleOptionalFields">
                <span class="ingredient-optional-chevron" aria-hidden="true">
                    <FluentIcon Value="@(new Icons.Regular.Size16.ChevronDown())" Color="Color.Custom" CustomColor="currentColor" />
                </span>
                <span>@(showOptionalFields ? "Dölj fält" : "Fler fält")</span>
                @if (!showOptionalFields && HasOptionalValues)
                {
                    <span class="ingredient-optional-indicator" aria-hidden="true">•</span>
                }
            </button>
            @if (showOptionalFields)
            {
                <div class="ingredient-optional-fields">
                    <FluentTextField @bind-Value="Ingredient.Comment" Immediate="true" ImmediateDelay="250" Placeholder="Kommentar (t.ex. à 200 g)" Title="Kommentar" Style="width: 100%;" />
                    <FluentTextField @bind-Value="Ingredient.Preparation" Immediate="true" ImmediateDelay="250" Placeholder="Beredning (t.ex. hackad)" Title="Beredning" Style="width: 100%;" />
                </div>
            }
        </div>
        @if (RowActions != null)
        {
            <div class="ingredient-row-actions">
                @RowActions
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Ingredient? Ingredient { get; set; }

    [Parameter]
    public string? FirstInputId { get; set; }

    [Parameter]
    public RenderFragment? RowActions { get; set; }

    [Parameter]
    public RenderFragment? DragHandle { get; set; }

    private Ingredient? _lastIngredientRef;
    private bool showOptionalFields;

    private bool HasOptionalValues =>
        !string.IsNullOrWhiteSpace(Ingredient?.Comment) ||
        !string.IsNullOrWhiteSpace(Ingredient?.Preparation);

    private string OptionalToggleAriaLabel =>
        showOptionalFields
            ? "Dölj kommentar och beredning"
            : (HasOptionalValues
                ? "Visa fler fält (innehåller kommentar eller beredning)"
                : "Visa fler fält (kommentar och beredning)");

    private string OptionalToggleTitle =>
        showOptionalFields
            ? "Dölj kommentar och beredning"
            : (HasOptionalValues
                ? "Visa kommentar och beredning (innehåller sparade värden)"
                : "Visa kommentar och beredning");

    protected override void OnParametersSet()
    {
        // Only initialize expansion state when the Ingredient reference changes so parent rerenders
        // do not collapse fields the user has opened or reset manual toggle choices.
        if (!ReferenceEquals(Ingredient, _lastIngredientRef))
        {
            _lastIngredientRef = Ingredient;
            showOptionalFields = HasOptionalValues;
        }
    }

    private void ToggleOptionalFields()
    {
        showOptionalFields = !showOptionalFields;
    }

    private string QuantityDisplay
    {
        get
        {
            if (Ingredient == null) return string.Empty;
            if (Ingredient.QuantityMax.HasValue && Ingredient.QuantityMax.Value > (Ingredient.Quantity ?? 0m))
            {
                var min = FormatQuantity(Ingredient.Quantity);
                var max = FormatQuantity(Ingredient.QuantityMax);
                return $"{min}–{max}";
            }
            return FormatQuantity(Ingredient.Quantity);
        }
        set
        {
            if (Ingredient == null) return;
            SetQuantityFromInput(value);
        }
    }

    private static string FormatQuantity(decimal? q)
    {
        if (!q.HasValue) return string.Empty;
        if (q.Value == 0.5m) return "½";
        if (q.Value == 0.25m) return "¼";
        if (q.Value == 0.75m) return "¾";
        if (q.Value == 0.33m) return "⅓";
        if (q.Value == 0.67m) return "⅔";
        if (q.Value == 0.125m) return "⅛";
        if (q.Value == Math.Floor(q.Value)) return ((int)q.Value).ToString();
        return q.Value.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("sv-SE"));
    }

    private void SetQuantityFromInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            Ingredient!.Quantity = null;
            Ingredient.QuantityMax = null;
            return;
        }

        var trimmed = value.Trim();
        var dashMatch = System.Text.RegularExpressions.Regex.Match(trimmed, @"^(.*?)\s*[-–—]\s*(.*)$");
        if (dashMatch.Success)
        {
            if (TryParseToken(dashMatch.Groups[1].Value, out var min) &&
                TryParseToken(dashMatch.Groups[2].Value, out var max))
            {
                Ingredient!.Quantity = min;
                Ingredient.QuantityMax = max;
                return;
            }
        }

        if (TryParseToken(trimmed, out var single))
        {
            Ingredient!.Quantity = single;
            Ingredient.QuantityMax = null;
            return;
        }
    }

    private static bool TryParseToken(string token, out decimal result)
    {
        result = 0;
        token = token.Trim();
        if (string.IsNullOrEmpty(token)) return false;

        if (token == "½") { result = 0.5m; return true; }
        if (token == "¼") { result = 0.25m; return true; }
        if (token == "¾") { result = 0.75m; return true; }
        if (token == "⅓") { result = 0.33m; return true; }
        if (token == "⅔") { result = 0.67m; return true; }
        if (token == "⅛") { result = 0.125m; return true; }

        var slashMatch = System.Text.RegularExpressions.Regex.Match(token, @"^(?:(\d+)\s+)?(\d+)/(\d+)$");
        if (slashMatch.Success &&
            int.TryParse(slashMatch.Groups[2].Value, out var num) &&
            int.TryParse(slashMatch.Groups[3].Value, out var den) && den > 0)
        {
            var whole = slashMatch.Groups[1].Success && int.TryParse(slashMatch.Groups[1].Value, out var w) ? w : 0;
            result = whole + Math.Round((decimal)num / den, 2);
            return true;
        }

        if (decimal.TryParse(token.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
        {
            result = parsed;
            return true;
        }

        return false;
    }
}
