@namespace Receptbanken.Web.Components.Recipes
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="form-section">
    <div class="ingredient-editor-header">
        @if (HeadingLevel == 3)
        {
            <h3 class="form-section-title" style="margin-bottom: 0;">@HeadingText</h3>
        }
        else
        {
            <h2 class="form-section-title" style="margin-bottom: 0;">@HeadingText</h2>
        }

        <div class="ingredient-editor-actions">
            <button type="button" class="btn-secondary-custom" @onclick="AddIngredient">
                @if (ShowAddIcon)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Color="Color.Neutral" />
                }
                @AddButtonText
            </button>

            <button type="button" class="btn-secondary-custom ingredient-add-section-btn" @onclick="AddSection">
                @if (ShowAddIcon)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Color="Color.Neutral" />
                }
                Lägg till sektion
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <p style="font-size: 13px; color: var(--rb-text-secondary); margin-bottom: 16px;">
            @HelpText
        </p>
    }

    <div class="ingredient-editor-list">
        @{
            var dropIndicator = draggedItemKey.HasValue && dragOverItemKey.HasValue
                ? _sectionList.GetDropIndicatorTarget(draggedItemKey.Value, dragOverItemKey.Value)
                : null;
        }
        @foreach (var item in _sectionList.Items)
        {
            var itemKey = item.Key;
            var isDragging = draggedItemKey == itemKey;
            var isDropTarget = dropIndicator.HasValue && dropIndicator.Value.IndicatorItemKey == itemKey;
            var dropDirectionClass = isDropTarget
                ? (dropIndicator!.Value.IsAbove ? "drag-over drag-over-above" : "drag-over drag-over-below")
                : string.Empty;
            var isReorderOpen = reorderMenuOpenKey == itemKey;

            <div @key="itemKey"
                 class="ingredient-editor-item @(item.IsSection ? "is-section-item" : "is-ingredient-item") @(isDragging ? "is-dragging" : "") @dropDirectionClass @(isReorderOpen ? "reorder-open" : "")"
                 data-editor-item-id="@itemKey"
                 data-item-kind="@(item.IsSection ? "section" : "ingredient")"
                 @ondragover="(() => HandleDragOver(itemKey))"
                 @ondragover:preventDefault="true"
                 @ondragenter="(() => HandleDragEnter(itemKey))"
                 @ondragleave="(() => HandleDragLeave(itemKey))"
                 @ondrop="(() => HandleDrop(itemKey))">

                @if (item.IsSection)
                {
                    var sectionIngCount = _sectionList.GetSectionIngredientCount(itemKey);
                    var isEmptySection = sectionIngCount == 0;
                    var isUnnamedSection = string.IsNullOrWhiteSpace(item.SectionTitle);
                    var sectionLabel = isUnnamedSection ? "sektion" : $"sektion {item.SectionTitle}";

                    <div class="ingredient-section-header-row @(isEmptySection ? "is-empty-section" : "")">
                        <input type="text"
                               id="@($"ingredient-section-input-{itemKey}")"
                               class="ingredient-section-title-input"
                               value="@item.SectionTitle"
                               maxlength="100"
                               placeholder="Sektionsrubrik (t.ex. Pajdeg, Sås)"
                               aria-label="Sektionsrubrik"
                               @oninput="@(e => RenameSection(itemKey, e.Value?.ToString() ?? string.Empty))" />

                        @if (isEmptySection)
                        {
                            <span class="ingredient-section-badge is-empty" title="Tomma sektioner sparas inte förrän du lägger till eller drar hit ingredienser">
                                Tom sektion (sparas inte)
                            </span>
                        }
                        else if (isUnnamedSection)
                        {
                            <span class="ingredient-section-badge is-ungrouped" title="Ingredienserna under en namnlös sektion sparas utan grupprubrik">
                                Utan rubrik (ogrupperad)
                            </span>
                        }

                        <div class="ingredient-row-actions">
                            <button type="button"
                                    class="btn-secondary-custom ingredient-row-convert-btn section-to-ingredient-btn"
                                    title="Gör till ingrediens"
                                    aria-label="@($"Gör {sectionLabel} till ingrediens")"
                                    @onclick="@(() => ConvertSectionToIngredient(itemKey))">
                                <FluentIcon Value="@(new Icons.Regular.Size16.TextBulletListLtr())" Color="Color.Neutral" />
                            </button>

                            <button type="button"
                                    class="btn-danger-custom ingredient-section-remove-btn"
                                    title="Ta bort sektion (ingredienser behålls)"
                                    aria-label="@($"Ta bort {sectionLabel} utan att radera ingredienser")"
                                    @onclick="@(() => RemoveSection(itemKey))">
                                ✕
                            </button>

                            <button type="button"
                                    class="ingredient-drag-handle @(isReorderOpen ? "is-reorder-active" : "")"
                                    draggable="true"
                                    title="@($"Dra för att flytta {sectionLabel}, eller tryck för flyttval")"
                                    aria-label="@($"Ändra ordning för {sectionLabel}")"
                                    aria-expanded="@(isReorderOpen ? "true" : "false")"
                                    @ondragstart="@(() => HandleDragStart(itemKey))"
                                    @ondragend="HandleDragEnd"
                                    @onclick="@(() => ToggleReorderMenu(itemKey))"
                                    @onclick:stopPropagation="true"
                                    @onkeydown="@(e => HandleDragHandleKeyDownAsync(e, itemKey))">
                                ⠿
                            </button>
                        </div>
                    </div>
                }
                else if (item.Ingredient != null)
                {
                    var ingLabel = string.IsNullOrWhiteSpace(item.Ingredient.Name) ? "ingrediens" : item.Ingredient.Name;

                    <RecipeIngredientRow Ingredient="item.Ingredient" OnRemove="@(() => RemoveIngredient(itemKey))">
                        <RowActions>
                            <button type="button"
                                    class="btn-secondary-custom ingredient-row-convert-btn ingredient-to-section-btn"
                                    title="Gör till sektion"
                                    aria-label="@($"Gör {ingLabel} till sektion")"
                                    @onclick="@(() => ConvertIngredientToSection(itemKey))">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Bookmark())" Color="Color.Neutral" />
                            </button>
                        </RowActions>
                        <DragHandle>
                            <button type="button"
                                    class="ingredient-drag-handle @(isReorderOpen ? "is-reorder-active" : "")"
                                    draggable="true"
                                    title="@($"Dra för att flytta {ingLabel}, eller tryck för flyttval")"
                                    aria-label="@($"Ändra ordning för {ingLabel}")"
                                    aria-expanded="@(isReorderOpen ? "true" : "false")"
                                    @ondragstart="@(() => HandleDragStart(itemKey))"
                                    @ondragend="HandleDragEnd"
                                    @onclick="@(() => ToggleReorderMenu(itemKey))"
                                    @onclick:stopPropagation="true"
                                    @onkeydown="@(e => HandleDragHandleKeyDownAsync(e, itemKey))">
                                ⠿
                            </button>
                        </DragHandle>
                    </RecipeIngredientRow>
                }

                @if (isReorderOpen)
                {
                    var targetDesc = item.IsSection
                        ? (string.IsNullOrWhiteSpace(item.SectionTitle) ? "sektion" : item.SectionTitle)
                        : (string.IsNullOrWhiteSpace(item.Ingredient?.Name) ? "ingrediens" : item.Ingredient!.Name);

                    <div class="ingredient-reorder-bar" role="group" aria-label="@($"Flytta {targetDesc}")">
                        <button type="button"
                                class="btn-secondary-custom ingredient-move-up-btn"
                                disabled="@(!_sectionList.CanMoveUp(itemKey))"
                                aria-label="@($"Flytta {targetDesc} uppåt")"
                                @onclick="@(() => MoveItemByOffset(itemKey, -1))">
                            ↑ Flytta upp
                        </button>
                        <button type="button"
                                class="btn-secondary-custom ingredient-move-down-btn"
                                disabled="@(!_sectionList.CanMoveDown(itemKey))"
                                aria-label="@($"Flytta {targetDesc} nedåt")"
                                @onclick="@(() => MoveItemByOffset(itemKey, 1))">
                            ↓ Flytta ned
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public IList<Ingredient> Ingredients { get; set; } = new List<Ingredient>();

    [Parameter]
    public string Title { get; set; } = "Ingredienser";

    [Parameter]
    public Func<int, string>? TitleFormatter { get; set; }

    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    [Parameter]
    public string? HelpText { get; set; }

    [Parameter]
    public string AddButtonText { get; set; } = "Lägg till ingrediens";

    [Parameter]
    public bool ShowAddIcon { get; set; } = true;

    [Parameter]
    public EventCallback<Ingredient> OnIngredientAdded { get; set; }

    [Parameter]
    public EventCallback<int> OnIngredientRemoved { get; set; }

    private readonly IngredientSectionList _sectionList = new();
    private IList<Ingredient>? _lastIngredientsRef;
    private DotNetObjectReference<RecipeIngredientEditor>? _dotNetRef;
    private bool _isDisposed;

    private int? draggedItemKey;
    private int? dragOverItemKey;
    private int? reorderMenuOpenKey;
    private int? _pendingFocusHandleKey;
    private int? _pendingFocusSectionInputKey;

    private string HeadingText => TitleFormatter != null
        ? TitleFormatter(_sectionList.IngredientCount)
        : Title;

    protected override void OnParametersSet()
    {
        // Only build the editor list when the Ingredients reference itself changes,
        // never on normal Blazor re-renders (so in-progress edits, empty sections, and drags are preserved).
        if (!ReferenceEquals(Ingredients, _lastIngredientsRef))
        {
            _lastIngredientsRef = Ingredients;
            _sectionList.LoadFromIngredients(Ingredients);
            draggedItemKey = null;
            dragOverItemKey = null;
            reorderMenuOpenKey = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("receptbanken.registerIngredientEditorTouchDrag", _dotNetRef);
            }
            catch
            {
                // Ignore when JS runtime is unavailable (e.g. unit tests)
            }
        }

        if (_pendingFocusSectionInputKey.HasValue)
        {
            var keyToFocus = _pendingFocusSectionInputKey.Value;
            _pendingFocusSectionInputKey = null;
            try
            {
                await JSRuntime.InvokeVoidAsync("receptbanken.focusElement", $"ingredient-section-input-{keyToFocus}");
            }
            catch
            {
                // Ignore when JS runtime is unavailable
            }
        }
        else if (_pendingFocusHandleKey.HasValue)
        {
            var keyToFocus = _pendingFocusHandleKey.Value;
            _pendingFocusHandleKey = null;
            try
            {
                await JSRuntime.InvokeVoidAsync("receptbanken.focusAndScrollIngredientEditorHandle", keyToFocus);
            }
            catch
            {
                // Ignore when JS runtime is unavailable
            }
        }
    }

    private async Task AddIngredient()
    {
        var newIng = new Ingredient { Name = string.Empty };
        _sectionList.AddIngredient(newIng, Ingredients);
        if (OnIngredientAdded.HasDelegate)
        {
            await OnIngredientAdded.InvokeAsync(newIng);
        }
    }

    private void AddSection()
    {
        var section = _sectionList.AddSection(string.Empty, Ingredients);
        _pendingFocusSectionInputKey = section.Key;
    }

    private void RenameSection(int sectionKey, string newTitle)
    {
        _sectionList.RenameSection(sectionKey, newTitle, Ingredients);
    }

    private void RemoveSection(int sectionKey)
    {
        if (reorderMenuOpenKey == sectionKey)
        {
            reorderMenuOpenKey = null;
        }
        _sectionList.RemoveSection(sectionKey, Ingredients);
    }

    private async Task RemoveIngredient(int ingredientKey)
    {
        var item = _sectionList.Items.FirstOrDefault(i => i.Key == ingredientKey && i.IsIngredient);
        int ingredientIndex = item?.Ingredient != null ? Ingredients.IndexOf(item.Ingredient) : -1;

        if (reorderMenuOpenKey == ingredientKey)
        {
            reorderMenuOpenKey = null;
        }

        if (_sectionList.RemoveIngredient(ingredientKey, Ingredients) &&
            ingredientIndex >= 0 &&
            OnIngredientRemoved.HasDelegate)
        {
            await OnIngredientRemoved.InvokeAsync(ingredientIndex);
        }
    }

    private void ConvertIngredientToSection(int ingredientKey)
    {
        if (reorderMenuOpenKey == ingredientKey)
        {
            reorderMenuOpenKey = null;
        }

        _sectionList.ConvertIngredientToSection(ingredientKey, Ingredients);
    }

    private void ConvertSectionToIngredient(int sectionKey)
    {
        if (reorderMenuOpenKey == sectionKey)
        {
            reorderMenuOpenKey = null;
        }

        _sectionList.ConvertSectionToIngredient(sectionKey, Ingredients);
    }

    private void HandleDragStart(int itemKey)
    {
        draggedItemKey = itemKey;
        dragOverItemKey = null;
    }

    private void HandleDragOver(int itemKey)
    {
        if (draggedItemKey.HasValue && draggedItemKey.Value != itemKey)
        {
            dragOverItemKey = itemKey;
        }
    }

    private void HandleDragEnter(int itemKey)
    {
        if (draggedItemKey.HasValue && draggedItemKey.Value != itemKey)
        {
            dragOverItemKey = itemKey;
        }
    }

    private void HandleDragLeave(int itemKey)
    {
        if (dragOverItemKey == itemKey)
        {
            dragOverItemKey = null;
        }
    }

    private void HandleDrop(int targetKey)
    {
        if (!draggedItemKey.HasValue)
        {
            return;
        }

        var sourceKey = draggedItemKey.Value;
        draggedItemKey = null;
        dragOverItemKey = null;

        _sectionList.MoveItem(sourceKey, targetKey, Ingredients);
    }

    private void HandleDragEnd()
    {
        draggedItemKey = null;
        dragOverItemKey = null;
    }

    private void ToggleReorderMenu(int itemKey)
    {
        reorderMenuOpenKey = reorderMenuOpenKey == itemKey ? null : itemKey;
    }

    private Task HandleDragHandleKeyDownAsync(KeyboardEventArgs e, int itemKey)
    {
        if (e.Key == "ArrowUp" && reorderMenuOpenKey == itemKey)
        {
            MoveItemByOffset(itemKey, -1, fromKeyboard: true);
        }
        else if (e.Key == "ArrowDown" && reorderMenuOpenKey == itemKey)
        {
            MoveItemByOffset(itemKey, 1, fromKeyboard: true);
        }
        else if (e.Key == "Escape" && reorderMenuOpenKey == itemKey)
        {
            reorderMenuOpenKey = null;
        }

        return Task.CompletedTask;
    }

    private void MoveItemByOffset(int itemKey, int direction, bool fromKeyboard = false)
    {
        if (_sectionList.MoveByOffset(itemKey, direction, Ingredients) && fromKeyboard)
        {
            _pendingFocusHandleKey = itemKey;
        }
    }

    [JSInvokable]
    public Task OnTouchDragStartAsync(int itemKey)
    {
        if (_isDisposed)
        {
            return Task.CompletedTask;
        }

        draggedItemKey = itemKey;
        dragOverItemKey = null;
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnTouchDropAsync(int sourceKey, int targetKey)
    {
        if (_isDisposed)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            if (_isDisposed)
            {
                return;
            }

            draggedItemKey = null;
            dragOverItemKey = null;
            _sectionList.MoveItem(sourceKey, targetKey, Ingredients);
            StateHasChanged();
        });
    }

    [JSInvokable]
    public async Task OnTouchDragCancelAsync()
    {
        if (_isDisposed)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            if (_isDisposed)
            {
                return;
            }

            draggedItemKey = null;
            dragOverItemKey = null;
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("receptbanken.unregisterIngredientEditorTouchDrag");
        }
        catch
        {
            // Ignore during prerender/teardown
        }

        _dotNetRef?.Dispose();
    }
}
